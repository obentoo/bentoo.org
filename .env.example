# Environment for local builds. Copy to .env (git-ignored) only for the
# PUBLIC_* values Astro reads through import.meta.env.
#
# Production is built and deployed by .github/workflows/deploy.yml, which sets
# its own build env. The Cloudflare credentials (CLOUDFLARE_API_TOKEN,
# CLOUDFLARE_ACCOUNT_ID) are GitHub Actions secrets: never put them here.

# Canonical origin for absolute URLs (canonical tags, sitemap, feeds).
# Unset or empty falls back to https://obentoo.org.
PUBLIC_SITE_URL=https://obentoo.org

# Optional. Newsletter handle; unset falls back to "bentoo".
# PUBLIC_BUTTONDOWN_USERNAME=bentoo
# Optional. Cloudflare Web Analytics beacon token; emitted only in a
# production build. Unset in production: obentoo.org uses Web Analytics
# auto-install, and a second beacon would double-count visits.
# PUBLIC_CF_ANALYTICS_TOKEN=

# --- Read from the shell environment, NOT from .env -------------------------
# These are read through process.env at build time; a .env file does not
# reach them. Export them in the shell (or set them in the workflow).
#
# PUBLIC_IS_PRODUCTION=true
#   Production build: indexable pages and the production robots.txt. Without
#   it the build ships noindex and a disallow-all robots.txt. The deploy
#   workflow sets it; leave it unset for local work.
#
# NOTICES_DIR=tests/fixtures/notices
#   Tests only. Loads notices from another directory; ignored in a production
#   build unless NOTICES_INTEGRATION_BUILD=true, which only the Playwright
#   webServer sets (playwright.config.ts). Never set either for a deploy.
