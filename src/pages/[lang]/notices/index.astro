---
// /<lang>/notices/ for every non-default locale (story 002, R5.2, R5.3).
import NoticesLayout from '~/layouts/NoticesLayout.astro';
import NoticesIndex from '~/components/notices/NoticesIndex.astro';
import { stringsFor } from '~/i18n';
import { LOCALES, DEFAULT_LOCALE, type Lang } from '~/utils/getLang';
import { localizedPath } from '~/utils/siteUrl';
import { loadNotices } from '~/utils/noticesCollection';

export function getStaticPaths() {
  return LOCALES.filter((l) => l !== DEFAULT_LOCALE).map((lang) => ({
    params: { lang },
  }));
}

type Params = { lang: Exclude<Lang, typeof DEFAULT_LOCALE> };
const { lang } = Astro.params as Params;
const s = stringsFor(lang);
const notices = await loadNotices();
---
<NoticesLayout
  lang={lang}
  path={localizedPath('/notices/', lang)}
  title={`${s.noticesTitle} — Bentoo`}
  description={s.noticesIntro}
  backHref={localizedPath('/', lang)}
  backLabel={s.backLink}
>
  <NoticesIndex notices={notices} lang={lang} />
</NoticesLayout>
