          <div class="row"><span class="k">Arch:</span><span class="v">x86-64-v3 · -O2 -pipe</span><span class="t">RÁPIDO</span></div>
          <div class="row"><span class="k">Licença:</span><span class="v">GPL-2.0-or-later</span><span class="t">LIVRE</span></div>
        </div>

        <div class="progress-wrap">
