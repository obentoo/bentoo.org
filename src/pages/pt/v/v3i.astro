    }
    .btn9x.pri{
      background:linear-gradient(180deg,#e1d9bc,#c7b575);
      border-top-color:#fff9cc;border-left-color:#fff9cc;
      font-weight:700;
    }
    .btn9x .arr{color:var(--pink)}
    .btn9x.pri .arr{color:#c8145c}

    .actions{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:16px}

    .crt-hint{
      background:#0d2813;
      color:#8bff73;
      padding:10px 12px 6px;
      font-family:var(--f-crt);font-size:17px;line-height:1.2;
      border:2px inset var(--chrome-dd);
      margin-bottom:4px;
      position:relative;overflow:hidden;
      min-height:200px;max-height:320px;overflow-y:auto;
      cursor:text;
    }
    .crt-hint::before{
      content:'';position:absolute;inset:0;
      background:repeating-linear-gradient(0deg,transparent 0 2px,rgba(0,0,0,.2) 2px 3px);
      pointer-events:none;z-index:1;
    }
    .crt-hint > *{position:relative;z-index:2}
    .crt-hint .ttl{color:#ffdf6b;margin-bottom:4px;font-size:14px;letter-spacing:.08em}
    .crt-hint .ok::before{content:'✓ ';color:#8bff73}
    .crt-hint .cur{display:inline-block;width:8px;height:14px;background:#8bff73;vertical-align:middle;animation:blink 1s step-end infinite;margin-left:2px}
    @keyframes blink{50%{opacity:0}}
    .crt-hint .crt-out > div{white-space:pre-wrap}
    .crt-hint .crt-out .yel{color:#ffdf6b}
    .crt-hint .crt-out .pink{color:#ff73bc}
    .crt-hint .crt-out .cyan{color:#73f0ff}
    .crt-hint .crt-line{display:flex;align-items:center;gap:4px}
    .crt-hint .crt-line .pmt{color:#8bff73;white-space:nowrap}
    .crt-hint .crt-line input{
