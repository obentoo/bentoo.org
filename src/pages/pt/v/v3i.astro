---
import VariantLayout from '~/layouts/VariantLayout.astro';
import { strings } from '~/i18n/pt';
const buttondownUser = import.meta.env.PUBLIC_BUTTONDOWN_USERNAME ?? 'bentoo';

// v3i variant-specific script — preserves legacy Windows-9x menus, clock,
// About dialog, and interactive MS-DOS shell. Content is author-authored at
// build time (no user input is rendered into the DOM).
const V3I_SCRIPT = `
(function(){
  var clk = document.getElementById('clk');
  var pad = function(n){ return String(n).padStart(2,'0'); };
  function tick(){
    if (!clk) return;
    var d = new Date();
    clk.textContent = d.getFullYear() + '/' + pad(d.getMonth()+1) + '/' + pad(d.getDate()) + ' · ' + pad(d.getHours()) + ':' + pad(d.getMinutes()) + ':' + pad(d.getSeconds());
  }
  tick(); setInterval(tick, 1000);

  var topbar = document.getElementById('topbar');
  if (!topbar) return;
  var menus = topbar.querySelectorAll('.menu');
  function closeAll(){ menus.forEach(function(m){ m.classList.remove('open'); }); }
  menus.forEach(function(m){
    m.addEventListener('click', function(e){
      if (e.target.closest('.dropdown')) return;
      var isOpen = m.classList.contains('open');
      closeAll();
      if (!isOpen) m.classList.add('open');
      e.stopPropagation();
    });
  });
  document.addEventListener('click', function(e){
    if (!topbar.contains(e.target)) closeAll();
  });

  var dlg = document.getElementById('about-dlg');
  function openDlg(){ if (dlg) dlg.classList.add('open'); }
  function closeDlg(){ if (dlg) dlg.classList.remove('open'); }
  if (dlg) {
    dlg.addEventListener('click', function(e){
      if (e.target === dlg || e.target.hasAttribute('data-close')) closeDlg();
    });
  }
  document.addEventListener('keydown', function(e){
    if (e.key === 'Escape') closeDlg();
  });

  var JOKES = {
    'new':    'Nova instalação — você já está instalando. Paciência.',
    'open':   'Abrir ISO — tente emerge em vez disso. É o nosso jeito.',
    'save':   'Progresso salvo em ~/.bentoo/state.ini (na verdade, não).',
    'print':  'Nenhuma impressora encontrada. Imprimir em arquivo? Fax? Windows 95? Nada funciona.',
    'exit':   'Isto é uma página web. Você não pode sair. Só pode fechar a aba.',
    'undo':   'Desfazer o quê, exatamente? A existência?',
    'redo':   'Não há refazer. Só emerge --resume.',
    'copy':   'Copiado: \`Um Stage5 amigável do Gentoo Linux.\`',
    'paste':  'Colado nada. (Nada para colar.)',
    'find':   'Localizar o quê? Ainda estamos procurando a data certa de lançamento.',
    'view-install':  'Você está olhando para ele.',
    'view-progress': 'Progresso: 47%. Sempre 47%. É uma filosofia.',
    'view-terminal': 'O terminal está bem ali. ↓',
    'zoom-in':  'Zoom com Ctrl+= no seu navegador. Isto é uma página web, lembra?',
    'zoom-out': 'Zoom com Ctrl+- no seu navegador.',
    'help-topics': 'Digite HELP no terminal para comandos reais.',
    'tips':   'Dica: experimente BANANA no terminal.'
  };
  topbar.addEventListener('click', function(e){
    var link = e.target.closest('[data-action]');
    if (!link) return;
    var action = link.getAttribute('data-action');
    e.preventDefault();
    closeAll();
    if (action === 'about'){ openDlg(); return; }
    var msg = JOKES[action];
    if (msg) alert(msg);
  });

  var out = document.getElementById('crt-out');
  var inp = document.getElementById('cinput');
  var crt = document.getElementById('crt');
  if (!out || !inp || !crt) return;
  var cmdHistory = []; var histIdx = -1;
  function esc(s){ return String(s).replace(/[&<>]/g, function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;'}[c];}); }
  function render(html){
    var div = document.createElement('div');
    // legacy DOS-shell output — author-controlled, no visitor input echoed unescaped.
    div.innerHTML = String(html).replace(/\\n/g, '<br>');
    out.appendChild(div);
    crt.scrollTop = crt.scrollHeight;
  }
  function promptLine(cmd){ render('<span class="yel">C:\\\\BENTOO&gt;</span> ' + esc(cmd)); }

  var CMDS = {
    'help': function(){ return [
      'BENTOO DOS — comandos disponíveis',
      '',
      '  <span class="yel">HELP</span>          mostra esta lista',
      '  <span class="yel">DIR</span>           lista arquivos',
      '  <span class="yel">CD</span>            muda de diretório',
      '  <span class="yel">TYPE</span> &lt;arq&gt;   imprime um arquivo de texto',
      '  <span class="yel">VER</span>           mostra a versão',
      '  <span class="yel">TIME</span>          mostra a hora atual',
      '  <span class="yel">DATE</span>          mostra a data atual',
      '  <span class="yel">EMERGE --INFO</span> mostra config do portage',
      '  <span class="yel">NEOFETCH</span>      resumo do sistema',
      '  <span class="yel">WHOAMI</span>        usuário atual',
      '  <span class="yel">FORTUNE</span>       sabedoria aleatória do gentoo',
      '  <span class="yel">BANANA</span>        🍌',
      '  <span class="yel">CLS</span>           limpa a tela',
      '  <span class="yel">EXIT</span>          tente',
      '',
      '<span class="pink">dica: SETAS navegam histórico · CTRL+L limpa</span>'
    ].join('\\n'); },
    'dir': function(){ return [
      ' Volume no drive C é BENTOO',
      ' Diretório de C:\\\\BENTOO',
      '',
      'BOOT         &lt;DIR&gt;    20-04-26  15:23',
      'ETC          &lt;DIR&gt;    20-04-26  15:23',
      'USR          &lt;DIR&gt;    20-04-26  15:23',
      'VAR          &lt;DIR&gt;    20-04-26  15:23',
      'README   TXT     1.248  20-04-26  15:23',
      'RELEASE  INI       512  20-04-26  15:23',
      'MAKE     CONF    2.048  20-04-26  15:23',
      '        7 Arquivo(s)   3.808 bytes',
      '                 bytes nunca suficientes livres'
    ].join('\\n'); },
    'ver': function(){ return 'Bentoo DOS Stage5 Extensions, Versão 0.1.0-alpha'; },
    'cd': function(){ return 'C:\\\\BENTOO'; },
    'time': function(){ return 'Hora atual: ' + new Date().toLocaleTimeString(); },
    'date': function(){ return 'Data atual: ' + new Date().toLocaleDateString(); },
    'whoami': function(){ return 'BENTOO\\\\ROOT'; },
    'type readme.txt': function(){ return [
      '=== README.TXT ==================================================',
      '',
      '  BENTOO — um Stage5 amigável do Gentoo Linux',
      '',
      '  Bentoo é um desktop Linux baseado em código-fonte que leva a',
      '  filosofia de instalação em estágios do Gentoo à sua conclusão',
      '  natural: um sistema pré-compilado, pré-configurado, utilizável',
      '  no dia a dia.',
      '',
      '  - Portage, inalterado',
      '  - USE flags, inalteradas',
      '  - Rolling release',
      '  - -march=x86-64-v3',
      '  - Desktop pronto desde o primeiro boot',
      '',
      '  Até o final de 2026.',
      '',
      '================================================================='
    ].join('\\n'); },
    'type release.ini': function(){ return [
      '[bentoo]',
      'version=0.1.0-alpha',
      'codename=kitchen-is-open',
      'channel=rolling',
      'arch=x86-64-v3',
      'license=GPL-2.0-or-later',
      'home=https://obentoo.org/'
    ].join('\\n'); },
    'type make.conf': function(){ return [
      'CFLAGS="-march=x86-64-v3 -O2 -pipe -fno-plt"',
      'CXXFLAGS="\${CFLAGS}"',
      'CHOST="x86_64-pc-linux-gnu"',
      'MAKEOPTS="-j12"',
      'USE="wayland pipewire vulkan X dbus elogind"',
      'ACCEPT_LICENSE="-* @FREE @BINARY-REDISTRIBUTABLE"',
      'PORTDIR_OVERLAY="/var/db/repos/bentoo"'
    ].join('\\n'); },
    'emerge --info': function(){ return [
      'Portage 3.0.65 (python 3.13.2, default/linux/amd64/17.1/desktop/bentoo, gcc-14.2)',
      'CFLAGS="-march=x86-64-v3 -O2 -pipe -fno-plt"',
      'USE="wayland pipewire vulkan X dbus elogind"',
      'FEATURES="parallel-fetch ebuild-locks sandbox"',
      'desktop Linux baseado em código-fonte · Stage5 · pronto para bootar'
    ].join('\\n'); },
    'neofetch': function(){ return [
      '   <span class="cyan">___           __             </span>   <span class="yel">BENTOO.EXE</span>',
      '  <span class="cyan">/ _ )___ ___  / /____  ___    </span>   ----------',
      ' <span class="cyan">/ _  / -_) _ \\\\/ __/ _ \\\\/ _ \\\\  </span>   OS:   bentoo 0.1.0-alpha',
      '<span class="cyan">/____/\\\\__/_//_/\\\\__/\\\\___/\\\\___/  </span>   KERN: 6.19.12-LTS',
      '',
      '<span class="pink">弁当 · ベントー</span>             SHELL: bash 5.2',
      '<span class="yel">Stage5 · baseado em código-fonte</span> ARCH:  x86-64-v3'
    ].join('\\n'); },
    'fortune': function(){
      var q = [
        'Código-fonte é lei. — mantenedor desconhecido',
        'Um pacote bem compilado é sua própria recompensa.',
        'USE flags: uma prece ao compilador.',
        'A única coisa que um bento e o gentoo têm em comum: disciplina.',
        '<span class="pink">静かに煮込み中</span> — cozinhando em fogo baixo, silenciosamente.',
        'Não use emerge --depclean numa sexta-feira.'
      ];
      return q[Math.floor(Math.random() * q.length)];
    },
    'banana': function(){ return [
      '      <span class="yel">___</span>',
      '    <span class="yel">.-\\'   \\\\</span>',
      '    <span class="yel">|  .-. )</span>',
      '    <span class="yel">| |  | |</span>   <span class="cyan">🍌 banana carregada.</span>',
      '    <span class="yel">| \\\`-\\' |</span>',
      '     <span class="yel">\\\\___/</span>',
      '<span class="pink">nano banana aprova.</span>'
    ].join('\\n'); },
    'cls': function(){ out.textContent = ''; return null; },
    'clear': function(){ out.textContent = ''; return null; },
    'exit': function(){ return '<span class="pink">isto é uma página web. você não pode sair. só pode fechar a aba.</span>'; },
    'shutdown': function(){ return 'Permissão negada. Boa tentativa.'; },
    'format c:': function(){ return 'Formatar o quê? Isto é uma página web.'; },
    'del *.*': function(){ return 'Você tá falando sério? Isto é uma página web.'; }
  };

  function run(raw){
    var cmd = raw.trim();
    if (!cmd) return;
    promptLine(cmd);
    cmdHistory.push(cmd); histIdx = cmdHistory.length;
    var key = cmd.toLowerCase();
    if (key.indexOf('type ') === 0){
      var file = key;
      if (CMDS[file]){ render(CMDS[file]()); return; }
      render('Arquivo não encontrado - ' + esc(cmd.slice(5).toUpperCase()));
      return;
    }
    if (CMDS[key]){
      var res = CMDS[key]();
      if (res !== null && res !== undefined) render(res);
      return;
    }
    render('Comando ou nome de arquivo inválido.');
  }

  inp.addEventListener('keydown', function(e){
    if (e.key === 'Enter'){ run(inp.value); inp.value = ''; }
    else if (e.key === 'ArrowUp'){ if (histIdx > 0){ histIdx--; inp.value = cmdHistory[histIdx]; } e.preventDefault(); }
    else if (e.key === 'ArrowDown'){ if (histIdx < cmdHistory.length - 1){ histIdx++; inp.value = cmdHistory[histIdx]; } else { histIdx = cmdHistory.length; inp.value = ''; } e.preventDefault(); }
    else if (e.ctrlKey && e.key === 'l'){ out.textContent = ''; e.preventDefault(); }
  });
})();
`.trim();
---
<VariantLayout
  lang="pt"
  path="/pt/v/v3i/"
  title="bentoo — install.exe"
  description="Bentoo é um Stage5 amigável do Gentoo Linux — uma distribuição desktop que vem pré-compilada, pré-configurada e pronta para bootar."
  variantSlug="v3i"
>
  <Fragment slot="head-extra">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DotGothic16&family=VT323&family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet" />
  </Fragment>
  <style slot="style">
    *,*::before,*::after{margin:0;padding:0;box-sizing:border-box}
    :root{
      --desk:#4b7d7d; --desk-2:#3a6363;
      --chrome:#c0c0c0; --chrome-d:#808080; --chrome-dd:#3a3a3a;
      --chrome-l:#ffffff; --chrome-ll:#dfdfdf;
      --title:#0a246a; --title-y:#f4d14a; --title-y2:#e1b832;
      --ink:#000; --link:#1818d4; --pink:#c8145c; --green:#0b873e;
      --f-pix:'DotGothic16',monospace;
      --f-crt:'VT323',monospace;
      --f-mono:'JetBrains Mono',monospace;
    }
    html{image-rendering:pixelated}
    html,body{background:var(--desk);color:var(--ink);font-family:var(--f-pix);font-size:14px;min-height:100vh;line-height:1.3;display:flex;flex-direction:column}
    body{
      background-color:var(--desk);
      background-image:
        radial-gradient(rgba(255,255,255,.15) 1px,transparent 1px),
        radial-gradient(rgba(0,0,0,.15) 1px,transparent 1px);
      background-size:8px 8px,8px 8px;
      background-position:0 0,4px 4px;
      overflow-x:hidden;
    }
    a{color:inherit;text-decoration:none}

    .topbar{
      background:var(--chrome);
      border-bottom:2px solid var(--chrome-dd);
      padding:3px 8px;
      display:flex;gap:4px;align-items:center;
      font-family:var(--f-pix);font-size:13px;
      position:sticky;top:0;z-index:40;
      box-shadow:inset 0 1px 0 var(--chrome-l);
    }
    .topbar .menu{position:relative;padding:3px 10px;cursor:pointer;user-select:none}
    .topbar .menu.brand{font-weight:700;color:var(--title)}
    .topbar .menu:hover{background:var(--chrome-ll)}
    .topbar .menu.open{background:var(--title);color:var(--chrome-l)}
    .topbar .menu.open.brand{color:var(--chrome-l)}
    .topbar .menu u{text-decoration:underline}
    .topbar .dropdown{
      display:none;
      position:absolute;top:100%;left:0;
      background:var(--chrome);
      border-top:2px solid var(--chrome-l);
      border-left:2px solid var(--chrome-l);
      border-right:2px solid var(--chrome-dd);
      border-bottom:2px solid var(--chrome-dd);
      box-shadow:3px 3px 0 rgba(0,0,0,.3);
      min-width:200px;
      z-index:50;
      padding:2px;
    }
    .topbar .menu.open .dropdown{display:block}
    .topbar .dropdown a, .topbar .dropdown button{
      display:block;width:100%;text-align:left;
      padding:5px 12px;
      font-family:var(--f-pix);font-size:12px;
      color:var(--ink);background:transparent;border:none;
      cursor:pointer;
    }
    .topbar .dropdown a:hover, .topbar .dropdown button:hover{background:var(--title);color:var(--chrome-l)}
    .topbar .dropdown hr{border:none;border-top:1px solid var(--chrome-d);margin:2px 4px}
    .topbar .dropdown a .key, .topbar .dropdown button .key{
      float:right;color:var(--pink);font-family:var(--f-mono);font-size:10px;margin-left:12px;
    }
    .topbar .dropdown a:hover .key, .topbar .dropdown button:hover .key{color:var(--title-y)}
    .topbar .clk{margin-left:auto;background:var(--chrome-ll);border:1px inset var(--chrome-dd);padding:2px 10px;font-family:var(--f-mono);font-size:11px;cursor:default}

    .dialog-backdrop{
      display:none;
      position:fixed;inset:0;background:rgba(0,0,0,.4);z-index:1000;
      align-items:center;justify-content:center;padding:20px;
    }
    .dialog-backdrop.open{display:flex}
    .dialog{
      background:var(--chrome);
      border-top:2px solid var(--chrome-l);
      border-left:2px solid var(--chrome-l);
      border-right:2px solid var(--chrome-dd);
      border-bottom:2px solid var(--chrome-dd);
      box-shadow:4px 4px 0 rgba(0,0,0,.4);
      max-width:440px;width:100%;
    }
    .dialog .dlg-bar{
      background:linear-gradient(90deg,var(--title),#1e49b5);
      color:var(--chrome-l);
      padding:5px 10px;
      display:flex;justify-content:space-between;align-items:center;
      font-family:var(--f-pix);font-size:13px;
      border-bottom:2px solid var(--chrome-dd);
    }
    .dialog .dlg-bar button{
      background:var(--chrome);
      border-top:1.5px solid var(--chrome-l);
      border-left:1.5px solid var(--chrome-l);
      border-right:1.5px solid var(--chrome-dd);
      border-bottom:1.5px solid var(--chrome-dd);
      width:20px;height:18px;padding:0;cursor:pointer;
      font-family:var(--f-mono);font-size:10px;color:var(--ink);font-weight:700;
    }
    .dialog .dlg-body{padding:20px 22px;font-family:var(--f-pix);font-size:13px;line-height:1.5}
    .dialog .dlg-body h3{font-size:18px;color:var(--title);margin-bottom:8px}
    .dialog .dlg-body p{margin-bottom:10px}
    .dialog .dlg-body b{color:var(--title)}
    .dialog .dlg-body em{font-style:normal;color:var(--pink);font-weight:700}
    .dialog .dlg-foot{
      padding:10px 18px;border-top:1px solid var(--chrome-d);background:var(--chrome-ll);
      text-align:right;
    }

    .marquee{
      background:var(--title);
      color:var(--title-y);
      padding:4px 0;
      overflow:hidden;white-space:nowrap;
      font-family:var(--f-crt);font-size:18px;letter-spacing:.08em;
      border-top:2px solid var(--chrome-l);
      border-bottom:2px solid var(--chrome-dd);
    }
    .mq{display:inline-flex;gap:42px;animation:scroll 60s linear infinite;padding-left:42px;width:max-content}
    .mq span{display:inline-flex;gap:10px;align-items:center}
    .mq i{color:var(--title-y);font-style:normal;font-family:var(--f-pix);font-size:16px}
    @keyframes scroll{to{transform:translate3d(-50%,0,0)}}

    .win{
      background:var(--chrome);
      border-top:2px solid var(--chrome-l);
      border-left:2px solid var(--chrome-l);
      border-right:2px solid var(--chrome-dd);
      border-bottom:2px solid var(--chrome-dd);
      box-shadow:
        inset -1px -1px 0 var(--chrome-d),
        inset 1px 1px 0 var(--chrome-ll),
        4px 4px 0 rgba(0,0,0,.3);
    }
    .win-bar{
      background:
        repeating-linear-gradient(90deg,var(--title-y) 0 4px,var(--title-y2) 4px 8px),
        var(--title-y);
      padding:5px 7px;
      display:flex;align-items:center;justify-content:space-between;
      color:var(--ink);
      font-family:var(--f-pix);font-size:14px;
      border-bottom:2px solid var(--chrome-dd);
      position:relative;
    }
    .win-bar::before{
      content:'';position:absolute;left:4px;right:4px;top:4px;bottom:4px;
      background:repeating-linear-gradient(90deg,transparent 0 8px,rgba(0,0,0,.2) 8px 10px);
      z-index:0;pointer-events:none;
    }
    .win-bar .title{
      background:var(--title-y);
      padding:0 8px;z-index:1;position:relative;
      font-weight:700;letter-spacing:.02em;
      display:inline-flex;align-items:center;gap:8px;
    }
    .win-bar .title::before{
      content:'';display:inline-block;width:14px;height:14px;
      background:
        linear-gradient(90deg,#e02020 33.33%,#2020e0 33.33% 66.66%,#e0a020 66.66%);
      border:1px solid var(--ink);
    }
    .win-bar .ctls{display:flex;gap:3px;z-index:1;position:relative}
    .win-bar .ctls b{
      display:inline-grid;place-items:center;
      width:22px;height:20px;
      background:var(--chrome);
      border-top:1.5px solid var(--chrome-l);
      border-left:1.5px solid var(--chrome-l);
      border-right:1.5px solid var(--chrome-dd);
      border-bottom:1.5px solid var(--chrome-dd);
      font-family:var(--f-mono);font-size:10px;font-weight:700;color:var(--ink);
      cursor:pointer;
    }
    .win-menu{
      background:var(--chrome);
      padding:2px 6px;
      display:flex;gap:14px;
      font-family:var(--f-pix);font-size:13px;
      border-bottom:1px solid var(--chrome-dd);
    }
    .win-menu span{padding:2px 6px;cursor:default}
    .win-menu span u{text-decoration:underline}
    .win-body{padding:20px 26px}

    main{
      flex:1;
      padding:30px 20px 20px;
      max-width:820px;
      margin:0 auto;
      width:100%;
    }

    .install-win{margin-bottom:14px}
    .install-win h1{
      font-family:var(--f-pix);
      font-size:clamp(44px,7vw,72px);
      line-height:1;letter-spacing:-.01em;
      margin-bottom:4px;color:var(--title);
      text-shadow:3px 3px 0 rgba(10,36,106,.15);
    }
    .install-win h1 em{font-style:normal;color:var(--pink)}
    .install-win h1 .period{color:#bc002d}
    .install-win .wiz-sub{
      font-family:var(--f-pix);font-size:15px;color:var(--ink);
      margin-bottom:4px;
    }
    .install-win .wiz-sub em{font-style:normal;color:var(--title);font-weight:700}
    .install-win .tagline{
      font-family:var(--f-pix);font-size:18px;color:var(--pink);
      margin-bottom:16px;letter-spacing:-.01em;
      padding:6px 0;border-bottom:1px dashed var(--chrome-d);
    }
    .install-win .tagline em{font-style:normal;color:var(--title);font-weight:700}

    .install-win .brief{
      font-family:var(--f-pix);font-size:14px;line-height:1.5;margin-bottom:14px;
    }
    .install-win .brief b{color:var(--title)}
    .install-win .brief em{font-style:normal;color:var(--pink);font-weight:700}

    .box-list{
      background:var(--chrome-ll);
      border:1px inset var(--chrome-dd);
      padding:10px 14px;
      margin-bottom:16px;
      font-family:var(--f-pix);font-size:13px;
    }
    .box-list .row{
      display:grid;grid-template-columns:140px 1fr auto;
      gap:12px;
      padding:3px 0;
      border-bottom:1px dotted rgba(0,0,0,.2);
    }
    .box-list .row:last-child{border:none}
    .box-list .k{font-weight:700;color:var(--title);letter-spacing:.02em}
    .box-list .v{color:var(--ink)}
