    .start-bar{
      background:var(--chrome);
      border-top:2px solid var(--chrome-l);
      padding:3px 6px;
      display:flex;align-items:center;gap:4px;
      box-shadow:inset 1px 1px 0 var(--chrome-ll);
    }
    .start-btn{
      background:var(--chrome);
      border-top:2px solid var(--chrome-l);
      border-left:2px solid var(--chrome-l);
      border-right:2px solid var(--chrome-dd);
      border-bottom:2px solid var(--chrome-dd);
      padding:5px 14px;
      display:inline-flex;gap:6px;align-items:center;
      font-family:var(--f-pix);font-size:13px;font-weight:700;
      cursor:pointer;
    }
    .start-btn .logo-dot{
      display:inline-block;width:14px;height:14px;
      background:
        linear-gradient(90deg,#e02020 33.33%,#2020e0 33.33% 66.66%,#e0a020 66.66%);
    }
    .task{
      padding:4px 10px;min-width:220px;
      background:var(--chrome);
      border-top:1.5px solid var(--chrome-dd);
      border-left:1.5px solid var(--chrome-dd);
      border-right:1.5px solid var(--chrome-l);
      border-bottom:1.5px solid var(--chrome-l);
      background-image:linear-gradient(45deg,rgba(0,0,0,.06) 25%,transparent 25%,transparent 50%,rgba(0,0,0,.06) 50%,rgba(0,0,0,.06) 75%,transparent 75%);
      background-size:4px 4px;
      font-family:var(--f-pix);font-size:12px;
      display:flex;align-items:center;gap:6px;
    }
    .task .ico{display:inline-grid;place-items:center;width:16px;height:16px;background:var(--title);color:var(--chrome-l);font-size:10px;font-family:var(--f-mono)}
    .tray{
      margin-left:auto;
      display:flex;align-items:center;gap:10px;padding:3px 8px;
      border-top:1.5px solid var(--chrome-dd);
      border-left:1.5px solid var(--chrome-dd);
      border-right:1.5px solid var(--chrome-l);
      border-bottom:1.5px solid var(--chrome-l);
      font-family:var(--f-mono);font-size:11px;
    }
    .tray .ic{color:var(--title);cursor:default;font-family:var(--f-pix);font-size:12px}
    .tray .ic.r{color:var(--pink)}
    .tray .clk{font-family:var(--f-mono);font-size:11px}

    @media (max-width:640px){
