---
import VariantLayout from '~/layouts/VariantLayout.astro';
import { strings } from '~/i18n/pt';
const buttondownUser = import.meta.env.PUBLIC_BUTTONDOWN_USERNAME ?? 'bentoo';
---
<VariantLayout
  lang="pt"
  path="/pt/v/v4/"
  title="bentoo — um Stage5 amigável do Gentoo Linux"
  description="Bentoo é um Stage5 amigável do Gentoo Linux — uma distribuição desktop que vem pré-compilada, pré-configurada e pronta para bootar."
  variantSlug="v4"
>
  <Fragment slot="head-extra">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,700;0,9..144,900;1,9..144,400;1,9..144,500&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&family=Noto+Serif+JP:wght@500;700;900&display=swap" rel="stylesheet" />
  </Fragment>
  <style slot="style">
    *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

    :root {
      --ink:        #5f5fd3;
      --ink-2:      #4b4bc4;
      --ink-deep:   #2d2d8f;
      --lavender:   #a69ff6;
      --sakura:     #e8375f;
      --sakura-2:   #d21f47;
      --gold:       #e8b954;
      --matcha:     #7ba654;

      --paper:      #ffffff;
      --paper-2:    #f6f4ea;
      --washi:      #f5efe0;
      --hinomaru:   #bc002d;
      --sumi:       #1a1a2e;
      --rule:       #d4d0bf;
      --rule-soft:  #e3dfcc;

      --text:       #1a1a2e;
      --text-soft:  #4a4668;
      --text-dim:   #7d7999;
      --text-faint: #b4afcc;

      --font-display: 'Fraunces', Georgia, serif;
      --font-sans:    'Inter', -apple-system, sans-serif;
      --font-mono:    'JetBrains Mono', ui-monospace, monospace;
      --font-jp:      'Noto Serif JP', serif;
    }

    html { scroll-behavior: smooth; }

    body {
      min-height: 100vh;
      background: var(--paper);
      color: var(--text);
      font-family: var(--font-sans);
      font-size: 15px;
      line-height: 1.55;
      -webkit-font-smoothing: antialiased;
      overflow-x: hidden;
      display: flex;
      flex-direction: column;
    }

    ::selection { background: var(--ink); color: var(--paper); }
    a { color: var(--ink); text-decoration: none; transition: color .15s; }
    a:hover { color: var(--sakura); }

    /* Ambient gradients — subtle radial */
    body::before {
      content: '';
      position: fixed;
      inset: 0;
      background:
        radial-gradient(ellipse 55% 45% at 50% 15%,  rgba(95, 95, 211, 0.12) 0%, transparent 60%),
        radial-gradient(ellipse 45% 35% at 15% 85%, rgba(232, 55, 95, 0.08) 0%, transparent 60%),
        radial-gradient(ellipse 45% 35% at 85% 85%, rgba(166, 159, 246, 0.1)  0%, transparent 60%);
      pointer-events: none;
      z-index: 0;
    }

    /* Grain overlay */
    body::after {
      content: '';
      position: fixed;
      inset: 0;
      opacity: 0.30;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 400 400' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.72' numOctaves='2' stitchTiles='stitch'/%3E%3CfeColorMatrix values='0 0 0 0 0.5 0 0 0 0 0.45 0 0 0 0 0.35 0 0 0 0.1 0'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
      pointer-events: none;
      z-index: 1;
      mix-blend-mode: multiply;
    }

    /* ===== HEADER ===== */
    header {
      position: relative;
      z-index: 5;
      padding: 22px 44px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-bottom: 1px solid var(--rule-soft);
      animation: fadeDown .7s ease-out both;
    }

    .brand {
      font-family: var(--font-display);
      font-weight: 900;
      font-size: 2rem;
      letter-spacing: -0.035em;
      color: var(--text);
      line-height: 1;
      display: inline-flex;
      align-items: baseline;
    }
    .brand em {
      font-style: italic;
      font-weight: 400;
      color: var(--ink);
    }
    .brand .period {
      color: var(--hinomaru);
      font-weight: 900;
    }

    /* Reusable round icon link (header + footer) */
    .icon-link {
      width: 40px;
      height: 40px;
      display: grid;
      place-items: center;
      border: 1px solid var(--rule);
      border-radius: 50%;
      background: var(--paper);
      color: var(--text);
      transition: all .2s;
    }
    .icon-link:hover {
      background: var(--sumi);
      border-color: var(--sumi);
      color: var(--paper);
      transform: translateY(-1px);
      box-shadow: 0 6px 16px rgba(26, 26, 46, 0.18);
    }
    .icon-link svg {
      width: 18px;
      height: 18px;
      fill: currentColor;
    }

    /* ===== TICKER STRIP ===== */
    .ticker-strip {
      position: relative;
      z-index: 4;
      background: var(--sumi);
      color: var(--paper);
      padding: 12px 0;
      overflow: hidden;
      border-bottom: 1px solid #000;
      animation: fadeDown .7s .1s ease-out both;
    }

    .ticker-strip .track {
      display: flex;
      gap: 48px;
      white-space: nowrap;
      animation: scroll 60s linear infinite;
      animation-play-state: running;
      will-change: transform;
      font-family: var(--font-display);
      font-weight: 600;
      font-size: 1.05rem;
      letter-spacing: -0.01em;
      width: max-content;
      padding-right: 48px;
    }

    @keyframes scroll {
      from { transform: translate3d(0, 0, 0); }
      to   { transform: translate3d(-50%, 0, 0); }
    }

    .ticker-strip .track span {
      display: inline-flex;
      align-items: center;
      gap: 16px;
    }

    .ticker-strip .track span::before {
      content: '';
      width: 8px; height: 8px;
      background: var(--hinomaru);
      border-radius: 50%;
      flex-shrink: 0;
    }
    .ticker-strip .track span:nth-child(2n)::before { background: var(--ink); }
    .ticker-strip .track span:nth-child(3n)::before { background: var(--gold); }
    .ticker-strip .track span:nth-child(4n)::before { background: var(--matcha); }

    .ticker-strip .track em {
      font-style: italic;
      font-family: var(--font-jp);
      color: var(--lavender);
      font-weight: 500;
      font-size: 1.15rem;
      line-height: 1;
    }

    /* ===== MAIN ===== */
    main {
      position: relative;
      z-index: 2;
      flex: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 40px 28px 72px;
      gap: 36px;
    }

    /* Logo (no frame, just the mark) */
    .logo-only {
      display: block;
      width: 100%;
      max-width: 360px;
      height: auto;
      filter: drop-shadow(0 4px 14px rgba(26, 26, 46, 0.08));
      animation: fadeUp 1s .1s ease-out both;
    }

    /* Description block */
    .desc {
      max-width: 620px;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 20px;
    }

    .tagline {
      font-family: var(--font-display);
      font-weight: 500;
      font-style: italic;
      font-size: clamp(1.35rem, 2.1vw, 1.75rem);
      color: var(--text);
      letter-spacing: -0.015em;
      line-height: 1.25;
      animation: fadeUp 1s .25s ease-out both;
    }
    .tagline em {
      font-style: normal;
      font-weight: 700;
      color: var(--ink);
      background: linear-gradient(180deg, transparent 62%, rgba(95, 95, 211, 0.14) 62%);
      padding: 0 3px;
    }

    .lede {
      font-family: var(--font-display);
      font-weight: 400;
      font-size: clamp(1.02rem, 1.35vw, 1.12rem);
      line-height: 1.65;
      color: var(--text-soft);
      animation: fadeUp 1s .4s ease-out both;
    }
    .lede em {
      font-style: italic;
      color: var(--ink);
      font-weight: 500;
    }
    .lede b {
      color: var(--sakura);
      font-weight: 600;
    }

    .jp-accent {
      font-family: var(--font-jp);
      font-size: 0.82rem;
      color: var(--text-dim);
      letter-spacing: 0.25em;
      display: inline-flex;
      align-items: center;
      gap: 12px;
      animation: fadeUp 1s .55s ease-out both;
    }
    .jp-accent::before, .jp-accent::after {
      content: '';
      width: 24px;
      height: 1px;
      background: var(--rule);
    }

    /* Newsletter */
    .notify {
      display: flex;
      width: 100%;
      max-width: 460px;
      animation: fadeUp 1s .7s ease-out both;
    }
    .notify input {
      flex: 1;
      padding: 14px 18px;
      border: 1.5px solid var(--rule);
      background: var(--paper);
      font-family: var(--font-mono);
      font-size: 13px;
      color: var(--text);
      border-right: none;
      transition: border-color .2s;
      outline: none;
      text-align: left;
    }
    .notify input:focus { border-color: var(--ink); }
    .notify input::placeholder { color: var(--text-faint); }
    .notify button {
      padding: 14px 24px;
      background: var(--sumi);
      color: var(--paper);
      border: 1.5px solid var(--sumi);
      font-family: var(--font-sans);
      font-weight: 700;
      font-size: 13px;
      letter-spacing: 0.04em;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 10px;
      transition: all .2s;
      white-space: nowrap;
    }
    .notify button:hover {
      background: var(--ink);
      border-color: var(--ink);
      box-shadow: 0 6px 16px rgba(95, 95, 211, 0.3);
    }
    .notify button .arr {
      color: var(--sakura);
      transition: transform .2s;
    }
    .notify button:hover .arr {
      transform: translateX(3px);
      color: var(--paper);
    }

    .notify-note {
      font-family: var(--font-mono);
      font-size: 10.5px;
      color: var(--text-dim);
      letter-spacing: 0.14em;
      text-transform: uppercase;
      margin-top: -18px;
      animation: fadeUp 1s .85s ease-out both;
    }
    .notify-note .priv {
      color: var(--matcha);
      font-weight: 700;
    }

    .privacy-consent {
      font-family: var(--font-mono);
      font-size: 10.5px;
      color: var(--text-dim);
      letter-spacing: 0.14em;
      text-transform: uppercase;
      margin-top: 0;
      text-align: center;
      max-width: 460px;
    }
    .privacy-consent a { color: var(--matcha); font-weight: 700; }

    /* ===== ANIMATIONS ===== */
    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(12px); }
      to   { opacity: 1; transform: translateY(0); }
    }
    @keyframes fadeDown {
      from { opacity: 0; transform: translateY(-8px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    /* ===== RESPONSIVE ===== */
    @media (max-width: 680px) {
      header { padding: 18px 22px; }
      .brand { font-size: 1.6rem; }
      main { padding: 28px 24px 56px; gap: 28px; }
      .logo-only { max-width: 260px; }
      .notify { flex-direction: column; }
      .notify input { border-right: 1.5px solid var(--rule); border-bottom: none; }
      .notify button { padding: 14px; justify-content: center; }
    }
  </style>

  <!-- ===== HEADER ===== -->
  <header>
    <a class="brand" href="./" aria-label="bentoo home">
      bent<em>oo</em><span class="period">.</span>
    </a>
    <a class="icon-link" href="https://github.com/obentoo" target="_blank" rel="noopener" aria-label="github — obentoo">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 .5C5.65.5.5 5.66.5 12.02c0 5.08 3.29 9.39 7.86 10.91.58.1.79-.25.79-.56 0-.28-.01-1.02-.02-2-3.19.69-3.86-1.54-3.86-1.54-.53-1.33-1.29-1.68-1.29-1.68-1.05-.72.08-.71.08-.71 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.23-1.28-5.23-5.68 0-1.26.45-2.28 1.18-3.08-.12-.29-.51-1.46.11-3.04 0 0 .97-.31 3.17 1.17.92-.26 1.9-.39 2.88-.39.98 0 1.97.13 2.88.39 2.2-1.48 3.16-1.17 3.16-1.17.63 1.58.24 2.75.12 3.04.73.8 1.18 1.82 1.18 3.08 0 4.41-2.69 5.38-5.25 5.67.41.35.77 1.06.77 2.13 0 1.54-.01 2.78-.01 3.16 0 .31.21.67.8.56 4.56-1.52 7.85-5.83 7.85-10.91C23.5 5.66 18.35.5 12 .5z"/></svg>
    </a>
  </header>

  <!-- ===== TICKER ===== -->
  <div class="ticker-strip" aria-hidden="true">
    <div class="track">
      <span><em>源</em> linux baseado em código-fonte</span>
      <span><em>常</em> rolling release</span>
      <span><em>包</em> 100+ ebuilds novos</span>
      <span><em>守</em> desktop pronto</span>
      <span><em>速</em> -march=x86-64-v3</span>
      <span><em>自</em> uso diário</span>
      <span><em>選</em> padrões opiniativos</span>
      <span><em>味</em> gentoo por dentro</span>
      <span><em>源</em> linux baseado em código-fonte</span>
      <span><em>常</em> rolling release</span>
      <span><em>包</em> 100+ ebuilds novos</span>
      <span><em>守</em> desktop pronto</span>
      <span><em>速</em> -march=x86-64-v3</span>
      <span><em>自</em> uso diário</span>
      <span><em>選</em> padrões opiniativos</span>
      <span><em>味</em> gentoo por dentro</span>
    </div>
  </div>

  <!-- ===== MAIN ===== -->
  <main>

    <img class="logo-only" src="/bentoo-logo.svg" alt="Bentoo logo" />

    <div class="desc">
      <div class="tagline">Um <em>Stage5</em> amigável do Gentoo Linux.</div>
      <p class="lede">
        Bentoo é um desktop Linux <em>baseado em código-fonte</em> que estende a
        filosofia de instalação em estágios do Gentoo à sua conclusão natural: <b>Stage5</b> — um
        sistema pré-compilado, pré-configurado, pronto para uso diário. Mantém a potência
        do Portage e o rigor das builds a partir do código-fonte, entregando
        um desktop completo desde o primeiro dia.
      </p>
      <div class="jp-accent">静かに煮込み中</div>
    </div>

    <form
      class="notify"
      data-bentoo-subscribe
      action={`https://buttondown.com/api/emails/embed-subscribe/${buttondownUser}`}
      method="post"
      data-success-msg={strings.successMsg}
      data-error-msg={strings.errorMsg}
    >
      <input type="hidden" name="embed" value="1" />
      <input type="email" name="email" required placeholder={strings.subscribePlaceholder} />
      <button type="submit">{strings.subscribeButton}</button>
    </form>
    <p class="privacy-consent">
      {strings.privacyConsent} <a href="/pt/privacy">{strings.privacyLinkLabel}</a>
    </p>
    <div class="notify-note">aviso único de lançamento · <span class="priv">sem newsletter</span> · descadastro embutido</div>

  </main>
</VariantLayout>
