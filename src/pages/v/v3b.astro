---
import VariantLayout from '~/layouts/VariantLayout.astro';
import { strings } from '~/i18n/en';
const buttondownUser = import.meta.env.PUBLIC_BUTTONDOWN_USERNAME ?? 'bentoo';
---
<VariantLayout
  lang="en"
  path="/v/v3b/"
  title="BENTOO 〜 アーケード・ディストリ 〜"
  description="Bentoo is a user-friendly Stage5 of Gentoo Linux."
  variantSlug="v3b"
>
  <Fragment slot="head-extra">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DotGothic16&family=VT323&family=Zen+Kaku+Gothic+New:wght@400;500;700;900&display=swap" rel="stylesheet" />
  </Fragment>
  <style slot="style">
    *,*::before,*::after{margin:0;padding:0;box-sizing:border-box}
    :root{
      --bg:#1a0e1f; --bg-2:#2b1a35;
      --magenta:#ff4fa8; --magenta-d:#c0277a;
      --cyan:#54d6ff; --cyan-d:#1b6dab;
      --yellow:#ffd340; --lime:#b6ff57;
      --ink:#110518; --white:#f4e9ef;
      --f-pix:'DotGothic16',monospace;
      --f-crt:'VT323',monospace;
      --f-jp:'Zen Kaku Gothic New',sans-serif;
    }
    html,body{background:var(--bg);color:var(--white);font-family:var(--f-pix);font-size:16px;min-height:100vh;line-height:1.35;display:flex;flex-direction:column}
    body{
      background:
        radial-gradient(900px 600px at 20% 20%,rgba(255,79,168,.14),transparent 60%),
        radial-gradient(900px 600px at 90% 80%,rgba(84,214,255,.12),transparent 60%),
        var(--bg);
      overflow-x:hidden;
    }
    body::before{
      content:'';position:fixed;inset:0;pointer-events:none;z-index:1000;
      background:repeating-linear-gradient(0deg,transparent 0 2px,rgba(255,255,255,.03) 2px 3px);
      mix-blend-mode:screen;
    }
    body::after{
      content:'';position:fixed;inset:0;pointer-events:none;z-index:999;
      background:repeating-linear-gradient(0deg,transparent 0 4px,rgba(0,0,0,.3) 4px 5px);
      opacity:.35;
    }
    a{color:inherit;text-decoration:none}

    .top-bar{
      background:var(--ink);border-bottom:2px solid var(--magenta);
      padding:8px 22px;display:flex;justify-content:space-between;align-items:center;
      font-family:var(--f-pix);font-size:12px;color:var(--cyan);letter-spacing:.1em;
      position:relative;z-index:10;
    }
    .top-bar .brand{color:var(--magenta)}
    .top-bar .brand em{color:var(--yellow);font-style:normal}

    .ticker{
      background:var(--ink);border-bottom:2px solid var(--cyan);
      padding:6px 0;overflow:hidden;white-space:nowrap;
      font-family:var(--f-crt);font-size:20px;
      position:relative;z-index:10;
    }
    .mq{display:inline-flex;gap:42px;animation:scroll 60s linear infinite;padding-left:42px;width:max-content}
    .mq span{display:inline-flex;gap:10px;align-items:center;color:var(--cyan)}
    .mq span:nth-child(2n){color:var(--magenta)}
    .mq span:nth-child(3n){color:var(--yellow)}
    .mq span:nth-child(4n){color:var(--lime)}
    .mq i{color:inherit;font-style:normal;font-family:var(--f-pix);font-size:15px}
    @keyframes scroll{to{transform:translate3d(-50%,0,0)}}

    main{flex:1;padding:56px 26px 72px;max-width:960px;margin:0 auto;width:100%;position:relative;z-index:2}

    .hero{text-align:center;margin-bottom:44px}
    .hero .jp-over{
      font-family:var(--f-jp);font-weight:900;
      font-size:clamp(18px,2vw,26px);
      color:var(--cyan);
      letter-spacing:.24em;margin-bottom:8px;
      text-shadow:0 0 14px var(--cyan-d);
    }
    .hero h1{
      font-family:var(--f-pix);
      font-size:clamp(62px,9vw,128px);
      line-height:.92;letter-spacing:-.02em;
      color:var(--white);
      text-shadow:
        4px 0 var(--magenta),-4px 0 var(--cyan),
        0 0 28px rgba(255,79,168,.4),
        0 0 48px rgba(84,214,255,.3);
    }
    .hero h1 em{font-style:normal;color:var(--magenta);text-shadow:4px 0 var(--cyan),-4px 0 var(--magenta),0 0 28px rgba(84,214,255,.4)}
    .hero h1 .dot{color:var(--yellow)}
    .hero .tagline{
      display:inline-block;margin-top:18px;
      background:var(--magenta);color:var(--ink);
      padding:8px 18px;font-family:var(--f-pix);font-size:16px;
      box-shadow:0 0 0 3px var(--ink),0 0 0 5px var(--magenta);
      letter-spacing:-.01em;
    }
    .hero .tagline em{font-style:normal;color:var(--ink);background:var(--yellow);padding:2px 8px;margin:0 3px;font-weight:400}

    .lede-wrap{max-width:620px;margin:0 auto 34px;text-align:center}
    .lede-wrap p{font-family:var(--f-pix);font-size:14px;line-height:1.55;color:var(--white)}
    .lede-wrap p b{color:var(--cyan);font-weight:400}
    .lede-wrap p em{font-style:normal;color:var(--magenta);font-weight:400}

    .stat-grid{
      display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-bottom:34px;
    }
    .stat{
      background:rgba(255,79,168,.08);
      border:2px solid var(--magenta);
      padding:14px 12px;text-align:center;
      font-family:var(--f-pix);font-size:11px;color:var(--white);
    }
    .stat:nth-child(2){border-color:var(--cyan);background:rgba(84,214,255,.08)}
    .stat:nth-child(3){border-color:var(--yellow);background:rgba(255,211,64,.08)}
    .stat:nth-child(4){border-color:var(--lime);background:rgba(182,255,87,.08)}
    .stat .n{display:block;font-family:var(--f-crt);font-size:28px;color:var(--magenta);line-height:1;margin-bottom:4px}
    .stat:nth-child(2) .n{color:var(--cyan)}
    .stat:nth-child(3) .n{color:var(--yellow)}
    .stat:nth-child(4) .n{color:var(--lime)}
    .stat .k{letter-spacing:.14em;opacity:.85}

    .actions{display:flex;gap:10px;flex-wrap:wrap;justify-content:center;margin-bottom:34px}
    .btn{
      padding:12px 24px;
      font-family:var(--f-pix);font-size:13px;letter-spacing:.12em;
      border:2.5px solid var(--cyan);color:var(--cyan);background:transparent;cursor:pointer;
      box-shadow:inset 0 0 0 0 var(--cyan);
      transition:all .15s;
    }
    .btn:hover{background:var(--cyan);color:var(--ink)}
    .btn.pri{border-color:var(--magenta);color:var(--magenta)}
    .btn.pri:hover{background:var(--magenta);color:var(--ink)}

    .notify{
      max-width:560px;margin:0 auto;
      background:rgba(17,5,24,.7);border:2px solid var(--cyan);padding:18px 22px;
      backdrop-filter:blur(6px);
    }
    .notify .lbl{font-family:var(--f-pix);font-size:11px;color:var(--cyan);letter-spacing:.14em;margin-bottom:10px;text-align:center}
    .notify .lbl b{color:var(--yellow)}
    .notify form{display:flex;gap:8px}
    .notify input{
      flex:1;padding:11px 14px;background:var(--ink);color:var(--white);
      border:2px solid var(--magenta);outline:none;
      font-family:var(--f-crt);font-size:17px;
    }
    .notify input:focus{border-color:var(--yellow)}
    .notify button{
      padding:0 22px;background:var(--magenta);color:var(--ink);border:2px solid var(--magenta);
      font-family:var(--f-pix);font-size:13px;cursor:pointer;letter-spacing:.12em;
    }
    .notify button:hover{background:var(--yellow);border-color:var(--yellow)}

    .privacy-consent{
      max-width:560px;margin:14px auto 0;font-family:var(--f-pix);font-size:11px;
      color:var(--cyan);text-align:center;
    }
    .privacy-consent a{color:var(--magenta);text-decoration:underline}

    footer{
      background:var(--ink);color:var(--cyan);
      padding:16px 22px;border-top:2px solid var(--magenta);
      display:flex;justify-content:space-between;align-items:center;gap:18px;flex-wrap:wrap;
      font-family:var(--f-pix);font-size:11px;
      position:relative;z-index:10;
    }
    footer em{color:var(--magenta);font-style:normal}
    footer .dot{color:var(--yellow)}
    footer a{color:var(--cyan)}
    footer a:hover{color:var(--magenta)}

    @media (max-width:640px){
      .stat-grid{grid-template-columns:repeat(2,1fr)}
      .notify form{flex-direction:column}
    }
  </style>

  <div class="top-bar">
    <span><span class="brand">BENTOO<em>.EXE</em></span> · アーケード・ディストリ</span>
    <span id="clk">00:00:00</span>
  </div>

  <div class="ticker" aria-hidden="true">
    <div class="mq">
      <span><i>源</i> source-based linux</span>
      <span><i>常</i> rolling release</span>
      <span><i>包</i> 100+ new ebuilds</span>
      <span><i>守</i> desktop ready</span>
      <span><i>速</i> -march=x86-64-v3</span>
      <span><i>自</i> daily driver</span>
      <span><i>選</i> opinionated defaults</span>
      <span><i>味</i> gentoo inside</span>
      <span><i>源</i> source-based linux</span>
      <span><i>常</i> rolling release</span>
      <span><i>包</i> 100+ new ebuilds</span>
      <span><i>守</i> desktop ready</span>
      <span><i>速</i> -march=x86-64-v3</span>
      <span><i>自</i> daily driver</span>
      <span><i>選</i> opinionated defaults</span>
      <span><i>味</i> gentoo inside</span>
    </div>
  </div>

  <main>
    <section class="hero">
      <div class="jp-over">弁当 · アーケード・ディストリ</div>
      <h1>BENT<em>OO</em><span class="dot">.</span></h1>
      <div class="tagline">A user-friendly <em>Stage5</em> of Gentoo Linux.</div>
    </section>

    <div class="lede-wrap">
      <p>
        A <em>source-based</em> Linux desktop for the neon arcade — <b>Stage5</b>
        of Gentoo, pre-compiled and pre-configured. Portage intact underneath, polish on top.
      </p>
    </div>

    <div class="stat-grid">
      <div class="stat"><span class="n">5</span><span class="k">STAGE</span></div>
      <div class="stat"><span class="n">30K</span><span class="k">EBUILDS</span></div>
      <div class="stat"><span class="n">v3</span><span class="k">X86-64</span></div>
      <div class="stat"><span class="n">'26</span><span class="k">RELEASE</span></div>
    </div>

    <div class="actions">
      <a class="btn pri" href="https://github.com/obentoo" target="_blank" rel="noopener">► SOURCE</a>
      <a class="btn" href="mailto:contact@obentoo.org">✉ CONTACT</a>
      <a class="btn" href="#notify">⚡ NOTIFY ME</a>
    </div>

    <div class="notify" id="notify">
      <div class="lbl">RELEASE PING · <b>ONE-SHOT</b> · NO NEWSLETTER</div>
      <form
        data-bentoo-subscribe
        action={`https://buttondown.com/api/emails/embed-subscribe/${buttondownUser}`}
        method="post"
        data-success-msg={strings.successMsg}
        data-error-msg={strings.errorMsg}
      >
        <input type="hidden" name="embed" value="1" />
        <input type="email" name="email" required placeholder={strings.subscribePlaceholder} />
        <button type="submit">{strings.subscribeButton}</button>
      </form>
    </div>
    <p class="privacy-consent">
      {strings.privacyConsent} <a href="/privacy">{strings.privacyLinkLabel}</a>
    </p>
  </main>

  <footer>
    <span>© 2018 – 2026 <em>BENTOO<span class="dot">.</span></em> · HANDCRAFTED, SOURCE-FIRST</span>
    <span>
      <a href="https://github.com/obentoo" target="_blank" rel="noopener">github.com/obentoo</a>
      ·
      <a href="mailto:contact@obentoo.org">contact@obentoo.org</a>
    </span>
  </footer>

  <script is:inline>
    (function(){
      var c=document.getElementById('clk');
      if (!c) return;
      var p=function(n){return String(n).padStart(2,'0');};
      function t(){var d=new Date();c.textContent=p(d.getHours())+':'+p(d.getMinutes())+':'+p(d.getSeconds());}
      t();setInterval(t,1000);
    })();
  </script>
</VariantLayout>
</content>
</invoke>