---
import VariantLayout from '~/layouts/VariantLayout.astro';
import { strings } from '~/i18n/en';
const buttondownUser = import.meta.env.PUBLIC_BUTTONDOWN_USERNAME ?? 'bentoo';
---
<VariantLayout
  lang="en"
  path="/v/beos/"
  title="bentoo — BeOS install wizard"
  description="Bentoo is a user-friendly Stage5 of Gentoo Linux."
  variantSlug="beos"
>
  <Fragment slot="head-extra">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Swiss+721+Condensed:wght@400;700&family=JetBrains+Mono:wght@400;600;700&family=VT323&display=swap" rel="stylesheet" />
  </Fragment>
  <style slot="style">
    *,*::before,*::after{margin:0;padding:0;box-sizing:border-box}
    :root{
      --desktop:#b4c4d2; --desktop-2:#8a9eb0;
      --chrome:#cfcfcf; --chrome-l:#e8e8e8; --chrome-d:#7a7a7a; --chrome-dd:#3a3a3a;
      --yellow:#ffcc33; --yellow-d:#d4a220;
      --blue:#3668b0; --blue-2:#264a7e;
      --red:#c8302a; --green:#43a532;
      --ink:#0d0d0d; --white:#f4f4f0;
      --f-sans:'Inter','Helvetica Neue',sans-serif;
      --f-mono:'JetBrains Mono',monospace;
      --f-crt:'VT323',monospace;
    }
    html,body{min-height:100vh;background:var(--desktop);color:var(--ink);font-family:var(--f-sans);font-size:12px;line-height:1.45;display:flex;flex-direction:column}
    body{
      background-color:var(--desktop);
      background-image:
        repeating-linear-gradient(0deg,transparent 0 1px,rgba(0,0,0,.03) 1px 2px),
        repeating-linear-gradient(90deg,transparent 0 1px,rgba(0,0,0,.03) 1px 2px);
      overflow-x:hidden;
    }
    body::before{
      content:'';position:fixed;inset:0;pointer-events:none;z-index:999;
      background:repeating-linear-gradient(0deg,transparent 0 3px,rgba(0,0,0,.04) 3px 4px);
    }
    a{color:inherit;text-decoration:none}

    /* Deskbar — top right (BeOS style) */
    .deskbar{
      position:fixed;top:0;right:0;z-index:50;
      background:var(--yellow);
      border-left:2px solid var(--ink);
      border-bottom:2px solid var(--ink);
      box-shadow:-2px 2px 0 rgba(0,0,0,.2);
      padding:0;
      width:160px;
    }
    .deskbar .tab{
      background:var(--yellow);padding:4px 10px;
      display:flex;justify-content:space-between;align-items:center;
      font-family:var(--f-sans);font-weight:700;font-size:11px;color:var(--ink);
      letter-spacing:.04em;
      border-bottom:1.5px solid var(--ink);
    }
    .deskbar .tab::before{
      content:'';display:inline-block;width:12px;height:12px;
      background:linear-gradient(135deg,var(--blue),var(--blue-2));margin-right:6px;
    }
    .deskbar .clk{
      font-family:var(--f-mono);font-size:10px;font-weight:700;
    }
    .deskbar .apps{
      padding:4px 6px;display:grid;grid-template-columns:1fr 1fr;gap:2px;
      background:var(--yellow-d);
    }
    .deskbar .apps span{
      background:var(--yellow);padding:3px 6px;font-size:9.5px;font-family:var(--f-mono);font-weight:700;
      border-top:1px solid rgba(255,255,255,.4);border-left:1px solid rgba(255,255,255,.4);
      border-right:1px solid var(--chrome-dd);border-bottom:1px solid var(--chrome-dd);
      cursor:default;text-align:center;letter-spacing:.04em;
    }

    main{flex:1;padding:50px 40px 40px;max-width:780px;margin:0 auto;width:100%;position:relative;z-index:2}

    /* Window (BeOS style) */
    .win{
      background:var(--chrome);
      border:1px solid var(--ink);
      box-shadow:4px 4px 0 rgba(0,0,0,.25),inset 1px 1px 0 var(--chrome-l);
      margin-bottom:14px;
    }
    .win-tab-row{
      display:flex;align-items:flex-end;border-bottom:1px solid var(--ink);
    }
    .win-tab{
      background:var(--yellow);
      padding:5px 16px 4px;
      font-family:var(--f-sans);font-weight:700;font-size:12px;color:var(--ink);
      border-top:1px solid var(--ink);border-left:1px solid var(--ink);border-right:1px solid var(--ink);
      letter-spacing:.02em;display:inline-flex;align-items:center;gap:8px;
      position:relative;top:1px;min-width:260px;
    }
    .win-tab::before{
      content:'';width:12px;height:12px;background:linear-gradient(135deg,var(--blue),var(--blue-2));
      display:inline-block;
    }
    .win-tab .close{
      margin-left:auto;
      width:12px;height:12px;background:var(--red);border:1px solid var(--ink);cursor:pointer;
    }
    .win-body{padding:22px 28px}
    .win-sub{background:var(--chrome-l);border-bottom:1px solid var(--chrome-d);padding:4px 12px;font-family:var(--f-mono);font-size:10.5px;color:var(--chrome-dd);letter-spacing:.06em;display:flex;justify-content:space-between}

    /* Wizard content */
    .step-pill{
      display:inline-block;background:var(--blue);color:var(--white);
      padding:3px 10px;font-family:var(--f-mono);font-weight:700;font-size:10.5px;letter-spacing:.14em;
      margin-bottom:14px;
    }
    .win-body h1{
      font-family:var(--f-sans);font-weight:700;
      font-size:clamp(38px,5vw,60px);
      line-height:.95;letter-spacing:-.025em;color:var(--ink);margin-bottom:6px;
    }
    .win-body h1 em{font-style:italic;font-weight:400;color:var(--blue)}
    .win-body h1 .dot{color:var(--red)}
    .win-body .tagline{
      font-family:var(--f-sans);font-weight:700;font-size:16px;color:var(--ink);
      margin-bottom:14px;
    }
    .win-body .tagline em{font-style:italic;font-weight:700;color:var(--blue);background:var(--yellow);padding:1px 6px}
    .win-body p.lede{font-family:var(--f-sans);font-size:13px;line-height:1.55;color:var(--ink);max-width:54ch;margin-bottom:16px}
    .win-body p.lede b{color:var(--blue);font-weight:700}
    .win-body p.lede em{font-style:italic;color:var(--red);font-weight:700}

    /* Install options (radio-like) */
    .opts{background:var(--chrome-l);border:1px solid var(--chrome-d);padding:10px 14px;margin-bottom:16px}
    .opts .row{display:grid;grid-template-columns:20px 1fr auto;gap:10px;padding:5px 0;border-bottom:1px dotted var(--chrome-d);align-items:center;font-family:var(--f-mono);font-size:11.5px}
    .opts .row:last-child{border:none}
    .opts .row .radio{
      width:12px;height:12px;border:1.5px solid var(--ink);border-radius:50%;display:inline-block;
      background:var(--white);
    }
    .opts .row.on .radio{background:var(--blue);box-shadow:inset 0 0 0 2px var(--white)}
    .opts .row b{color:var(--blue);font-weight:700}
    .opts .row .t{color:var(--green);font-weight:700;font-size:10.5px;letter-spacing:.12em}

    /* Progress */
    .progress{
      background:var(--white);border:1px solid var(--chrome-dd);
      height:20px;margin-bottom:14px;position:relative;padding:2px;
    }
    .progress .bar{
      height:100%;
      background:
        repeating-linear-gradient(90deg,var(--blue) 0 10px,transparent 10px 14px),
        linear-gradient(90deg,var(--blue),var(--blue-2));
      width:47%;
    }
    .progress .lbl{position:absolute;inset:0;display:grid;place-items:center;font-family:var(--f-mono);font-size:10.5px;color:var(--ink);text-shadow:1px 1px 0 var(--white)}

    /* Actions */
    .actions{display:flex;gap:8px;flex-wrap:wrap}
    .btn{
      padding:5px 16px;
      background:linear-gradient(180deg,var(--chrome-l),var(--chrome));
      border-top:1px solid var(--chrome-l);
      border-left:1px solid var(--chrome-l);
      border-right:1px solid var(--chrome-dd);
      border-bottom:1px solid var(--chrome-dd);
      font-family:var(--f-sans);font-weight:700;font-size:11.5px;color:var(--ink);
      cursor:pointer;display:inline-flex;gap:8px;align-items:center;letter-spacing:.04em;
    }
    .btn:hover{background:linear-gradient(180deg,#fff,var(--chrome-l))}
    .btn:active{border-top:1px solid var(--chrome-dd);border-left:1px solid var(--chrome-dd);border-right:1px solid var(--chrome-l);border-bottom:1px solid var(--chrome-l)}
    .btn.pri{background:linear-gradient(180deg,#ffdd55,var(--yellow-d));border-top-color:#fff066}
    .btn .arr{color:var(--red)}

    /* Notify form inside second window */
    .notify-win .win-tab{background:var(--blue);color:var(--white)}
    .notify-win .win-tab::before{background:var(--yellow)}
    .notify form{display:flex;gap:4px}
    .notify input{
      flex:1;padding:5px 10px;background:var(--white);
      border-top:1px solid var(--chrome-dd);border-left:1px solid var(--chrome-dd);
      border-right:1px solid var(--chrome-l);border-bottom:1px solid var(--chrome-l);
      font-family:var(--f-mono);font-size:11.5px;color:var(--ink);outline:none;
    }
    .notify input:focus{background:var(--white);border-color:var(--blue)}
    .notify .note{font-family:var(--f-mono);font-size:10px;color:var(--chrome-dd);letter-spacing:.08em;margin-top:6px}
    .notify .note b{color:var(--green)}

    /* Status line */
    .statusbar{
      background:var(--chrome);padding:3px 14px;border-top:1px solid var(--chrome-dd);
      display:flex;justify-content:space-between;align-items:center;
      font-family:var(--f-mono);font-size:10px;color:var(--chrome-dd);letter-spacing:.08em;
    }
    .statusbar .ok{background:var(--green);color:var(--white);padding:1px 6px;font-weight:700;letter-spacing:.1em}

    footer{
      padding:18px 40px 28px;max-width:780px;margin:0 auto;width:100%;
      display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap;
      font-family:var(--f-mono);font-size:10.5px;color:var(--chrome-dd);letter-spacing:.12em;text-transform:uppercase;
      position:relative;z-index:2;
    }
    footer em{color:var(--blue);font-style:italic;font-weight:700;font-family:var(--f-sans);letter-spacing:normal;text-transform:none;font-size:13px}
    footer em .dot{color:var(--red)}
    footer a{color:var(--chrome-dd)}
    footer a:hover{color:var(--blue)}

    .privacy-consent{
      font-family:var(--f-mono);font-size:10px;color:var(--chrome-dd);letter-spacing:.08em;margin-top:8px;
    }
    .privacy-consent a{color:var(--blue);font-weight:700}

    @media (max-width:640px){
      .deskbar{width:140px}
      .win-tab{min-width:200px;font-size:11px}
      main{padding:42px 16px 30px}
      .win-body{padding:18px 20px}
      .notify form{flex-direction:column}
      footer{padding:18px 20px}
    }
  </style>

  <div class="deskbar">
    <div class="tab"><span>Be</span><span class="clk" id="clk">--:--</span></div>
    <div class="apps">
      <span>Tracker</span>
      <span>Deskbar</span>
      <span>Mail</span>
      <span>Terminal</span>
    </div>
  </div>

  <main>
    <div class="win">
      <div class="win-tab-row">
        <div class="win-tab">bentoo-install<span class="close"></span></div>
      </div>
      <div class="win-sub"><span>bentoo-install · step 2 of 4 · SELECT VOLUME</span><span>BFS journal · OK</span></div>
      <div class="win-body">
        <span class="step-pill">STEP 2/4 · SELECT TARGET</span>
        <h1>bent<em>oo</em><span class="dot">.</span></h1>
        <div class="tagline">A user-friendly <em>Stage5</em> of Gentoo Linux.</div>
        <p class="lede">
          The installer will copy <em>Bentoo 0.1.0-alpha</em> to your selected volume.
          <b>Bentoo</b> is a <em>source-based</em> Linux desktop — a <b>Stage5</b> of Gentoo.
          Pre-compiled, pre-configured, Portage still under the hood.
        </p>

        <div class="opts">
          <div class="row on"><span class="radio"></span><span><b>/dev/sda2</b> · bentoo-root · BFS · 40.0 GB · <em>ready</em></span><span class="t">SELECTED</span></div>
          <div class="row"><span class="radio"></span><span>/dev/sda1 · BeOS 5 PE · BFS · 10.0 GB · system</span><span class="t">SKIP</span></div>
          <div class="row"><span class="radio"></span><span>/dev/sda3 · home · BFS · 180 GB · personal</span><span class="t">KEEP</span></div>
        </div>

        <div class="progress">
          <div class="bar"></div>
          <div class="lbl">Stage5 packages · 47% · ETA late 2026</div>
        </div>

        <div class="actions">
          <a class="btn" href="../">&lt; Back</a>
          <a class="btn pri" href="https://github.com/obentoo" target="_blank" rel="noopener">Source <span class="arr">→</span></a>
          <a class="btn" href="mailto:contact@obentoo.org">Contact <span class="arr">→</span></a>
          <a class="btn" href="#notify">Notify me <span class="arr">→</span></a>
        </div>
      </div>
      <div class="statusbar">
        <span>C:\bentoo\install · 0.1.0-alpha</span>
        <span><span class="ok">READY</span> &nbsp; <span>bentoo-install v0.1</span></span>
      </div>
    </div>

    <div class="win notify-win" id="notify">
      <div class="win-tab-row">
        <div class="win-tab">release-ping<span class="close"></span></div>
      </div>
      <div class="win-body notify">
        <form
          data-bentoo-subscribe
          action={`https://buttondown.com/api/emails/embed-subscribe/${buttondownUser}`}
          method="post"
          data-success-msg={strings.successMsg}
          data-error-msg={strings.errorMsg}
        >
          <input type="hidden" name="embed" value="1" />
          <input type="email" name="email" required placeholder={strings.subscribePlaceholder} />
          <button class="btn pri" type="submit">{strings.subscribeButton} <span class="arr">→</span></button>
        </form>
        <p class="privacy-consent">
          {strings.privacyConsent} <a href="/privacy">{strings.privacyLinkLabel}</a>
        </p>
        <div class="note">RELEASE PING · <b>ONE-SHOT</b> · NO NEWSLETTER · UNSUBSCRIBE BUILT-IN</div>
      </div>
    </div>
  </main>

  <footer>
    <span>© 2018 – 2026 <em>bent<span style="color:var(--blue);font-weight:400;font-style:italic">oo</span><span class="dot">.</span></em> · HANDCRAFTED · SOURCE-FIRST</span>
    <span>
      <a href="https://github.com/obentoo" target="_blank" rel="noopener">github.com/obentoo</a>
      ·
      <a href="mailto:contact@obentoo.org">contact@obentoo.org</a>
    </span>
  </footer>

  <script is:inline>
    (function(){
      var c=document.getElementById('clk');
      if(!c) return;
      var p=function(n){return String(n).padStart(2,'0');};
      function t(){var d=new Date();c.textContent=p(d.getHours())+':'+p(d.getMinutes());}
      t();setInterval(t,1000);
    })();
  </script>
</VariantLayout>
