---
import VariantLayout from '~/layouts/VariantLayout.astro';
import { strings } from '~/i18n/en';
const buttondownUser = import.meta.env.PUBLIC_BUTTONDOWN_USERNAME ?? 'bentoo';
---
<VariantLayout
  lang="en"
  path="/v/minecraft/"
  title="bentoo — singleplayer · new world (stage5)"
  description="Bentoo — a user-friendly Stage5 of Gentoo Linux. Mine. Craft. Compile."
  variantSlug="minecraft"
>
  <Fragment slot="head-extra">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Jersey+15&family=Press+Start+2P&family=VT323&display=swap" rel="stylesheet" />
  </Fragment>
  <style is:global slot="style">
    *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

    .v-minecraft {
      --sky-1:  #7ec0ee;
      --sky-2:  #a9d9f2;
      --grass:  #5ab142;
      --grass-d:#3a7826;
      --grass-l:#86d170;
      --dirt:   #8b5a2b;
      --dirt-l: #b58a5c;
      --dirt-d: #5a3818;
      --stone:  #878787;
      --stone-l:#c0c0c0;
      --stone-d:#5a5a5a;
      --wood:   #9c7c4d;
      --wood-d: #5e4422;
      --redstone:#ea3a3a;
      --creeper:#6ba657;
      --creeper-d:#4a7a34;
      --water:  #407aa8;
      --gold:   #f3c542;
      --diamond:#5ff0e2;
      --diamond-d:#1a8a7a;
      --iron:   #c8c8d0;
      --nether: #a0165c;
      --end:    #1a1020;
      --lava:   #e85a1a;
      --heart:  #e02030;
      --hunger: #b68242;
      --xp:     #8cf040;
      --text:   #f8f8f8;
      --dark:   #0a0a0a;

      background: var(--sky-1);
      color: var(--text);
      font-family: 'Jersey 15', 'VT323', monospace;
      min-height: 100vh;
      position: relative;
      overflow-x: hidden;
      image-rendering: pixelated;
      -webkit-font-smoothing: none;
      display: block;
    }

    .v-minecraft::before {
      content: '';
      position: fixed;
      inset: 0;
      z-index: 0;
      background: linear-gradient(180deg,
        #6eb6e7 0%,
        var(--sky-1) 30%,
        var(--sky-2) 65%,
        #c6e2f2 100%);
    }

    /* Sun */
    .v-minecraft .sun {
      position: absolute;
      top: 9%;
      right: 8%;
      width: 72px;
      height: 72px;
      background: var(--gold);
      box-shadow:
        0 0 0 8px rgba(243,197,66,.25),
        0 0 0 16px rgba(243,197,66,.1);
      z-index: 2;
    }

    /* Pixelated clouds */
    .v-minecraft .cloud {
      position: absolute;
      background: #fff;
      box-shadow:
        10px 0 0 #fff, 20px 0 0 #fff, 30px 0 0 #fff, 40px 0 0 #fff,
        50px 0 0 #fff, 60px 0 0 #fff, 70px 0 0 #fff, 80px 0 0 #fff,
        90px 0 0 #fff, 100px 0 0 #fff, -10px 10px 0 #fff, 0 10px 0 #fff,
        10px 10px 0 #fff, 20px 10px 0 #fff, 30px 10px 0 #fff, 40px 10px 0 #fff,
        50px 10px 0 #fff;
      width: 10px; height: 10px;
      opacity: .85;
      animation: minecraft-cloudDrift 100s linear infinite;
    }
    .v-minecraft .cloud.c1 { top: 10%; left: 6%; }
    .v-minecraft .cloud.c2 { top: 18%; left: 55%; animation-delay: -30s; }
    .v-minecraft .cloud.c3 { top: 7%;  left: 34%; animation-delay: -55s; }
    @keyframes minecraft-cloudDrift {
      0%   { transform: translateX(0); }
      100% { transform: translateX(60px); }
    }

    /* ========== HEADER TABS ========== */
    .v-minecraft header {
      position: relative;
      z-index: 10;
      padding: 14px 28px 0;
      display: flex;
      gap: 6px;
      align-items: flex-end;
    }
    .v-minecraft .tab {
      padding: 7px 18px 10px;
      background: rgba(40,40,40,.75);
      color: #ddd;
      font-family: 'Jersey 15', monospace;
      font-size: 18px;
      letter-spacing: 0.04em;
      border: 2px solid #000;
      border-bottom: none;
      box-shadow: inset 0 2px 0 rgba(255,255,255,.15);
    }
    .v-minecraft .tab.active {
      background: #dcdcdc;
      color: #000;
      box-shadow: inset 0 2px 0 #fff;
    }
    .v-minecraft .addr-bar {
      margin-left: auto;
      padding: 6px 16px;
      background: #dcdcdc;
      color: #000;
      border: 2px solid #000;
      font-family: 'Jersey 15', monospace;
      font-size: 18px;
      letter-spacing: 0.04em;
    }
    .v-minecraft .addr-bar b { color: var(--grass-d); }

    /* ========== FPS / STATS (top left) ========== */
    .v-minecraft .fps-stats {
      position: fixed;
      top: 68px;
      left: 16px;
      z-index: 8;
      padding: 6px 10px;
      background: rgba(0,0,0,.5);
      font-family: 'Jersey 15', monospace;
      font-size: 14px;
      color: #fff;
      line-height: 1.4;
      letter-spacing: 0.04em;
      text-shadow: 2px 2px 0 #000;
    }
    .v-minecraft .fps-stats b { color: var(--gold); }
    .v-minecraft .fps-stats .good { color: var(--grass-l); }
    .v-minecraft .fps-stats .bad { color: var(--redstone); }

    /* ========== MAIN ========== */
    .v-minecraft main {
      position: relative;
      z-index: 5;
      padding: 26px 28px 250px;
      min-height: calc(100vh - 60px);
      display: grid;
      grid-template-columns: 1fr 320px;
      gap: 28px;
      align-items: start;
    }

    .v-minecraft .center-col {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 20px;
    }

    /* Isometric block wordmark */
    .v-minecraft .block-word {
      display: flex;
      gap: 0;
      filter: drop-shadow(0 14px 14px rgba(0,0,0,.35));
      text-align: center;
    }
    .v-minecraft .block-word span {
      position: relative;
      display: inline-block;
      width: clamp(66px, 11vw, 118px);
      height: clamp(70px, 12vw, 126px);
      font-family: 'Jersey 15', monospace;
      font-size: clamp(3rem, 7vw, 5.2rem);
      line-height: 1;
      color: var(--text);
      text-align: center;
      padding-top: 16px;
      background:
        linear-gradient(180deg, var(--dirt-l) 0%, var(--dirt) 40%, var(--dirt-d) 100%);
      box-shadow:
        inset 3px 0 0 rgba(255,255,255,.15),
        inset -3px 0 0 rgba(0,0,0,.3),
        inset 0 -3px 0 rgba(0,0,0,.4);
      border: 3px solid #000;
      text-shadow: 3px 3px 0 #000, 3px 0 0 #000, 0 3px 0 #000;
      overflow: hidden;
    }
    .v-minecraft .block-word span::before {
      content: '';
      position: absolute;
      top: 0; left: 0; right: 0;
      height: 18px;
      background:
        repeating-linear-gradient(90deg,
          var(--grass-l) 0 4px,
          var(--grass) 4px 8px,
          var(--grass-d) 8px 10px);
      border-bottom: 3px solid var(--grass-d);
    }
    .v-minecraft .block-word span::after {
      content: '';
      position: absolute;
      inset: 18px 3px 3px 3px;
      background:
        radial-gradient(circle at 22% 34%, rgba(0,0,0,.2) 0 3px, transparent 4px),
        radial-gradient(circle at 72% 60%, rgba(255,255,255,.08) 0 2px, transparent 3px),
        radial-gradient(circle at 48% 80%, rgba(0,0,0,.15) 0 2px, transparent 3px),
        radial-gradient(circle at 30% 70%, rgba(0,0,0,.12) 0 2.5px, transparent 3.5px);
      pointer-events: none;
    }

    .v-minecraft .tagline {
      font-family: 'Jersey 15', monospace;
      font-size: clamp(1.1rem, 2.6vw, 1.85rem);
      color: #fff;
      letter-spacing: 0.08em;
      text-shadow: 3px 3px 0 #000, -1px 1px 0 #000, 1px -1px 0 #000, -1px -1px 0 #000;
    }
    .v-minecraft .tagline b { color: var(--gold); text-shadow: 3px 3px 0 #000; }

    /* Main menu buttons */
    .v-minecraft .mc-menu {
      display: flex;
      flex-direction: column;
      gap: 8px;
      width: min(400px, 92%);
    }
    .v-minecraft .mc-btn {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 14px;
      padding: 14px 20px;
      text-align: center;
      font-family: 'Jersey 15', monospace;
      font-size: 22px;
      letter-spacing: 0.06em;
      color: #fff;
      text-decoration: none;
      background:
        linear-gradient(180deg, var(--stone-l) 0%, var(--stone) 50%, var(--stone-d) 100%);
      border: 3px solid #000;
      box-shadow:
        inset 3px 3px 0 rgba(255,255,255,.22),
        inset -3px -3px 0 rgba(0,0,0,.3),
        4px 4px 0 rgba(0,0,0,.45);
      text-shadow: 2px 2px 0 #000;
      transition: all .1s steps(2);
    }
    .v-minecraft .mc-btn:hover {
      background: linear-gradient(180deg, #d8d8d8 0%, #a0a0a0 100%);
      transform: translate(1px,1px);
      box-shadow: inset 3px 3px 0 rgba(255,255,255,.22), inset -3px -3px 0 rgba(0,0,0,.3), 2px 2px 0 rgba(0,0,0,.45);
    }
    .v-minecraft .mc-btn.grass {
      background: linear-gradient(180deg, var(--grass-l) 0%, var(--grass) 50%, var(--grass-d) 100%);
    }
    .v-minecraft .mc-btn.redstone {
      background: linear-gradient(180deg, #ff5a5a 0%, var(--redstone) 50%, #a01818 100%);
    }
    .v-minecraft .mc-btn.diamond {
      background: linear-gradient(180deg, #9af4ea 0%, var(--diamond) 50%, var(--diamond-d) 100%);
      color: #0c2a2a;
      text-shadow: 2px 2px 0 #fff;
    }
    .v-minecraft .mc-btn .pre-icon {
      width: 22px; height: 22px;
      display: inline-grid; place-items: center;
    }
    .v-minecraft .mc-btn .pre-icon svg { width: 100%; height: 100%; }

    /* Chat / notify */
    .v-minecraft .chat {
      position: relative;
      width: min(480px, 92%);
      padding: 10px 14px;
      background: rgba(0,0,0,.55);
      border: 2px solid #000;
      font-family: 'Jersey 15', monospace;
      color: #fff;
    }
    .v-minecraft .chat .log {
      font-size: 14px;
      letter-spacing: 0.04em;
      color: #ddd;
      margin-bottom: 6px;
      line-height: 1.5;
    }
    .v-minecraft .chat .log .you { color: var(--grass-l); }
    .v-minecraft .chat .log .steve { color: var(--gold); }
    .v-minecraft .chat .log .creeper { color: var(--creeper); }
    .v-minecraft .chat-row { display: flex; gap: 6px; }
    .v-minecraft .chat-row input {
      flex: 1;
      padding: 6px 10px;
      background: rgba(20,20,20,.9);
      border: 2px solid #000;
      color: #fff;
      font-family: 'Jersey 15', monospace;
      font-size: 18px;
      outline: none;
    }
    .v-minecraft .chat-row button {
      padding: 6px 16px;
      background: linear-gradient(180deg, var(--grass-l) 0%, var(--grass-d) 100%);
      color: #fff;
      border: 2px solid #000;
      font-family: 'Jersey 15', monospace;
      font-size: 18px;
      cursor: pointer;
      text-shadow: 2px 2px 0 #000;
      letter-spacing: 0.06em;
    }

    /* Privacy consent shared template text */
    .v-minecraft .privacy-consent {
      font-family: 'Jersey 15', monospace;
      font-size: 13px;
      letter-spacing: 0.06em;
      color: #ddd;
      margin-top: 8px;
      width: min(480px, 92%);
      padding: 8px 14px;
      background: rgba(0,0,0,.35);
      border: 2px solid #000;
      text-shadow: 1px 1px 0 #000;
    }
    .v-minecraft .privacy-consent a { color: var(--gold); text-decoration: underline; }

    /* ========== RIGHT COLUMN ========== */
    .v-minecraft .right-col {
      display: flex;
      flex-direction: column;
      gap: 14px;
    }

    .v-minecraft .bestiary {
      background: rgba(0,0,0,.55);
      border: 2px solid #000;
      padding: 12px 14px;
      color: #fff;
      font-family: 'Jersey 15', monospace;
    }
    .v-minecraft .bestiary .bst-title {
      font-size: 20px;
      color: var(--gold);
      letter-spacing: 0.08em;
      margin-bottom: 8px;
      text-shadow: 2px 2px 0 #000;
      text-align: center;
    }
    .v-minecraft .bestiary .bst-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 6px;
    }
    .v-minecraft .mob {
      background: rgba(30,30,30,.9);
      border: 2px solid #000;
      padding: 6px 4px 20px;
      text-align: center;
      position: relative;
      cursor: default;
    }
    .v-minecraft .mob svg { width: 100%; aspect-ratio: 1; }
    .v-minecraft .mob .mob-name {
      position: absolute;
      bottom: 3px; left: 0; right: 0;
      font-size: 14px;
      color: #fff;
      letter-spacing: 0.04em;
      text-shadow: 1px 1px 0 #000;
    }
    .v-minecraft .mob .hp {
      position: absolute;
      top: 3px; right: 4px;
      font-size: 11px;
      color: var(--heart);
      text-shadow: 1px 1px 0 #000;
    }

    /* Crafting 3x3 */
    .v-minecraft .crafting {
      background: rgba(139,90,43,.95);
      border: 2px solid #000;
      padding: 10px;
      position: relative;
      color: #fff;
      font-family: 'Jersey 15', monospace;
    }
    .v-minecraft .crafting .ct-title {
      font-size: 18px;
      color: #fff;
      margin-bottom: 6px;
      text-shadow: 1px 1px 0 #000;
      letter-spacing: 0.06em;
      text-align: center;
    }
    .v-minecraft .crafting .ct-grid {
      display: grid;
      grid-template-columns: 1fr 1fr 1fr auto 1fr;
      gap: 4px;
      align-items: center;
    }
    .v-minecraft .slot {
      aspect-ratio: 1;
      background: rgba(0,0,0,.45);
      border: 2px solid #2a1808;
      box-shadow: inset 2px 2px 0 rgba(255,255,255,.08), inset -2px -2px 0 rgba(0,0,0,.3);
      display: grid; place-items: center;
    }
    .v-minecraft .slot svg { width: 80%; height: 80%; }
    .v-minecraft .arrow {
      color: #fff;
      font-size: 24px;
      text-shadow: 2px 2px 0 #000;
      padding: 0 6px;
    }

    /* XP level */
    .v-minecraft .xp-lvl {
      background: rgba(0,0,0,.55);
      border: 2px solid #000;
      padding: 10px 12px;
      color: #fff;
      font-family: 'Jersey 15', monospace;
      font-size: 18px;
      letter-spacing: 0.04em;
      text-align: center;
    }
    .v-minecraft .xp-lvl b { color: var(--xp); text-shadow: 0 0 8px var(--xp); }

    /* ========== BOTTOM HUD ========== */
    .v-minecraft .hud-bottom {
      position: fixed;
      bottom: 0; left: 0; right: 0;
      z-index: 10;
      padding: 12px 28px 10px;
      background: linear-gradient(180deg, transparent 0%, rgba(10,10,10,.7) 70%);
      pointer-events: none;
    }
    .v-minecraft .hud-center {
      max-width: 560px;
      margin: 0 auto;
      pointer-events: auto;
    }
    .v-minecraft .hud-bars {
      display: flex;
      gap: 6px;
      justify-content: space-between;
      margin-bottom: 4px;
      font-family: 'Jersey 15', monospace;
      color: #fff;
      text-shadow: 2px 2px 0 #000;
      font-size: 16px;
    }
    .v-minecraft .hud-bars .side { display: flex; gap: 2px; }
    .v-minecraft .hp-row svg, .v-minecraft .food-row svg {
      width: 14px; height: 14px;
      filter: drop-shadow(1px 1px 0 #000);
    }
    .v-minecraft .xp-bar {
      height: 10px;
      background: #2a2a2a;
      border: 1px solid #000;
      position: relative;
      margin-bottom: 4px;
    }
    .v-minecraft .xp-bar::before {
      content: '';
      position: absolute;
      left: 0; top: 0; bottom: 0;
      width: 62%;
      background: linear-gradient(180deg, #b0ff5a 0%, var(--xp) 50%, #5aa020 100%);
      box-shadow: 0 0 6px rgba(140,240,64,.5);
    }
    .v-minecraft .xp-label {
      position: absolute;
      left: 50%;
      top: 50%;
      transform: translate(-50%,-50%);
      color: var(--xp);
      font-family: 'Jersey 15', monospace;
      font-size: 12px;
      text-shadow: 1px 1px 0 #000, -1px -1px 0 #000;
    }

    .v-minecraft .hotbar {
      display: grid;
      grid-template-columns: repeat(9, 1fr);
      gap: 0;
      border: 3px solid #000;
      background: rgba(40,40,40,.9);
      padding: 2px;
      position: relative;
    }
    .v-minecraft .hotslot {
      aspect-ratio: 1;
      border: 2px solid #2a2a2a;
      box-shadow: inset 2px 2px 0 rgba(255,255,255,.08), inset -2px -2px 0 rgba(0,0,0,.3);
      display: grid; place-items: center;
      padding: 4px;
      background: rgba(60,60,60,.7);
      position: relative;
    }
    .v-minecraft .hotslot svg { width: 80%; height: 80%; }
    .v-minecraft .hotslot.selected {
      border-color: #fff;
      box-shadow: 0 0 0 2px #fff, inset 2px 2px 0 rgba(255,255,255,.15);
    }
    .v-minecraft .hotslot .count {
      position: absolute;
      bottom: 1px;
      right: 3px;
      font-family: 'Jersey 15', monospace;
      font-size: 13px;
      color: #fff;
      text-shadow: 1px 1px 0 #000;
    }

    /* crosshair center */
    .v-minecraft .crosshair-mc {
      position: fixed;
      top: 42%;
      left: 50%;
      transform: translate(-50%,-50%);
      z-index: 7;
      pointer-events: none;
    }
    .v-minecraft .crosshair-mc::before, .v-minecraft .crosshair-mc::after {
      content: '';
      position: absolute;
      background: rgba(255,255,255,.8);
      mix-blend-mode: difference;
    }
    .v-minecraft .crosshair-mc::before { width: 16px; height: 2px; top: -1px; left: -8px; }
    .v-minecraft .crosshair-mc::after  { width: 2px; height: 16px; top: -8px; left: -1px; }

    @media (max-width: 980px) {
      .v-minecraft header { padding: 10px 14px 0; flex-wrap: wrap; }
      .v-minecraft .addr-bar { margin: 8px 0 0; width: 100%; }
      .v-minecraft main { grid-template-columns: 1fr; padding: 20px 14px 260px; gap: 20px; }
      .v-minecraft .fps-stats { font-size: 11px; }
      .v-minecraft .bestiary .bst-grid { grid-template-columns: repeat(3, 1fr); }
      .v-minecraft .hud-bottom { padding: 10px 12px 6px; }
    }
    @media (max-width: 540px) {
      .v-minecraft .crafting .ct-grid { grid-template-columns: 1fr 1fr 1fr auto 1fr; gap: 2px; }
    }
  </style>

  <div class="v-minecraft">
    <!-- Sun & clouds -->
    <div class="sun" aria-hidden="true"></div>
    <div class="cloud c1" aria-hidden="true"></div>
    <div class="cloud c2" aria-hidden="true"></div>
    <div class="cloud c3" aria-hidden="true"></div>

    <!-- Header -->
    <header>
      <span class="tab active">◉ BENTOO | Home</span>
      <span class="tab">Docs</span>
      <span class="tab">Forum</span>
      <span class="tab">Realms</span>
      <span class="addr-bar">⛭ <b>bentoo.linux.org</b></span>
    </header>

    <!-- FPS / debug F3 -->
    <div class="fps-stats">
      BENTOO 1.21.5 (<b>Stage5 build</b>)<br />
      <b>60</b> fps <span class="good">T: stable</span> · <span class="good">C: 22/22</span><br />
      XYZ: <b>182.34 / 64.00 / -304.12</b><br />
      Block: <b>minecraft:grass_block</b><br />
      Biome: <b>forest</b> · <span class="good">peaceful</span><br />
      Light: <b>15</b> (sky 15, block 0)
    </div>

    <div class="crosshair-mc" aria-hidden="true"></div>

    <main>
      <div class="center-col">
        <div class="block-word" aria-label="BENTOO">
          <span>B</span><span>E</span><span>N</span><span>T</span><span>O</span><span>O</span>
        </div>
        <div class="tagline">A USER-FRIENDLY <b>STAGE5</b> OF GENTOO LINUX</div>

        <nav class="mc-menu">
          <a class="mc-btn grass" href="https://github.com/obentoo" target="_blank" rel="noopener">
            <span class="pre-icon">
              <svg viewBox="0 0 22 22"><path d="M11 .5C5.15.5.5 5.1.5 10.9c0 4.6 3 8.5 7.15 9.9.5.1.7-.2.7-.5v-2c-2.9.6-3.5-1.4-3.5-1.4-.5-1.2-1.2-1.5-1.2-1.5-1-.7.1-.7.1-.7 1.1.1 1.6 1.1 1.6 1.1.9 1.6 2.5 1.1 3 .9.1-.7.4-1.1.7-1.4-2.3-.3-4.8-1.2-4.8-5.2 0-1.1.4-2.1 1.1-2.8-.1-.3-.5-1.3.1-2.8 0 0 .9-.3 2.9 1.1.8-.2 1.8-.4 2.7-.4s1.9.1 2.7.4c2-1.4 2.9-1.1 2.9-1.1.6 1.5.2 2.5.1 2.8.7.7 1.1 1.7 1.1 2.8 0 4-2.5 4.9-4.8 5.2.4.3.7 1 .7 2v3c0 .3.2.6.7.5 4.15-1.4 7.15-5.3 7.15-9.9C21.5 5.1 16.85.5 11 .5z" fill="currentColor"/></svg>
            </span>
            GITHUB · SINGLEPLAYER
          </a>
          <a class="mc-btn diamond" href="mailto:contact@obentoo.org">
            <span class="pre-icon">
              <svg viewBox="0 0 22 22"><path d="M2 4h18v14H2z" fill="none" stroke="currentColor" stroke-width="2"/><path d="M2 5l9 7 9-7" fill="none" stroke="currentColor" stroke-width="2"/></svg>
            </span>
            CONTACT · MULTIPLAYER
          </a>
          <a class="mc-btn redstone" href="#notify">
            <span class="pre-icon">
