---
import VariantLayout from '~/layouts/VariantLayout.astro';
import { strings } from '~/i18n/en';
const buttondownUser = import.meta.env.PUBLIC_BUTTONDOWN_USERNAME ?? 'bentoo';
---
<VariantLayout
  lang="en"
  path="/v/matrix/"
  title="bentoo — wake up, gentoo"
  description="Bentoo — a user-friendly Stage5 of Gentoo Linux. Source is power."
  variantSlug="matrix"
>
  <Fragment slot="head-extra">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Share+Tech+Mono&family=VT323&family=Orbitron:wght@500;700;900&display=swap" rel="stylesheet" />
  </Fragment>
  <style is:global slot="style">
    *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

    .v-matrix {
      --bg:       #00070c;
      --green-0:  #c8ffd5;
      --green:    #36e26a;
      --green-2:  #22a24a;
      --green-3:  #0c5c22;
      --amber:    #f3c43a;
      --amber-2:  #b38420;
      --blue:     #4fb1ff;
      --red:      #ff3a3a;
      --red-glow: #ff555d;
      --text-dim: rgba(54,226,106,.65);

      background: var(--bg);
      color: var(--green);
      font-family: 'Share Tech Mono', monospace;
      min-height: 100vh;
      position: relative;
      overflow: hidden;
      -webkit-font-smoothing: antialiased;
      display: block;
    }

    .v-matrix #rain {
      position: fixed;
      inset: 0;
      z-index: 0;
      pointer-events: none;
      opacity: .85;
    }

    /* vignette + scanline */
    .v-matrix::before {
      content: '';
      position: fixed; inset: 0;
      z-index: 2;
      pointer-events: none;
      background:
        radial-gradient(ellipse 70% 55% at 50% 50%, transparent 30%, rgba(0,0,0,.75) 100%);
    }
    .v-matrix::after {
      content: '';
      position: fixed; inset: 0;
      z-index: 3;
      pointer-events: none;
      background: repeating-linear-gradient(180deg, transparent 0 2px, rgba(0,0,0,.25) 2px 3px);
      opacity: .4;
    }

    /* ========= BROWSER CHROME SIM ========= */
    .v-matrix .chrome {
      position: relative;
      z-index: 10;
      padding: 10px 24px;
      display: flex;
      align-items: center;
      gap: 18px;
      font-family: 'Share Tech Mono', monospace;
      font-size: 12px;
      color: var(--text-dim);
      border-bottom: 1px solid rgba(54,226,106,.15);
      background: rgba(0,10,16,.55);
      backdrop-filter: blur(4px);
    }
    .v-matrix .chrome .tabs { display: flex; gap: 6px; }
    .v-matrix .chrome .tab {
      padding: 4px 14px 5px;
      border: 1px solid rgba(54,226,106,.25);
      font-size: 11px;
      letter-spacing: 0.14em;
      color: var(--text-dim);
      background: rgba(8,20,14,.7);
    }
    .v-matrix .chrome .tab.active { color: var(--green); border-color: var(--green); text-shadow: 0 0 6px var(--green); }
    .v-matrix .chrome .search {
      margin-left: auto;
      padding: 4px 12px;
      border: 1px solid rgba(54,226,106,.2);
      color: var(--text-dim);
      min-width: 240px;
      font-size: 11px;
    }

    .v-matrix .url-bar {
      padding: 8px 24px;
      display: flex; align-items: center; gap: 14px;
      font-family: 'Share Tech Mono', monospace;
      font-size: 12.5px;
      color: var(--green);
      border-bottom: 1px solid rgba(54,226,106,.15);
      background: rgba(0,10,16,.65);
      position: relative; z-index: 10;
    }
    .v-matrix .url-bar .dot {
      width: 8px; height: 8px; border-radius: 50%;
      background: var(--green);
      box-shadow: 0 0 8px var(--green);
    }
    .v-matrix .url-bar .addr {
      flex: 1;
      padding: 4px 10px;
      border: 1px solid rgba(54,226,106,.2);
      background: rgba(8,20,14,.7);
    }
    .v-matrix .url-bar .addr b { color: var(--green-0); }

    /* ========= MAIN ========= */
    .v-matrix main {
      position: relative;
      z-index: 5;
      min-height: calc(100vh - 120px);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 20px 24px 120px;
      gap: 28px;
    }

    /* Massive wordmark */
    .v-matrix .wordmark {
      font-family: 'Orbitron', sans-serif;
      font-weight: 900;
      font-size: clamp(3.6rem, 13vw, 10rem);
      letter-spacing: 0.14em;
      color: var(--green-0);
      text-shadow:
        0 0 10px var(--green),
        0 0 22px var(--green),
        0 0 42px rgba(54,226,106,.55),
        0 0 72px rgba(54,226,106,.35);
      position: relative;
      line-height: 1;
      animation: matrix-pulseGlow 3.4s ease-in-out infinite;
    }
    @keyframes matrix-pulseGlow {
      0%,100% { filter: brightness(1); }
      50%     { filter: brightness(1.18); }
    }
    .v-matrix .wordmark::before {
      content: attr(data-text);
      position: absolute;
      inset: 0;
      color: transparent;
      -webkit-text-stroke: 1px rgba(54,226,106,.15);
      text-stroke: 1px rgba(54,226,106,.15);
      pointer-events: none;
    }

    .v-matrix .sub-wake {
      font-family: 'VT323', monospace;
      font-size: clamp(1.4rem, 3vw, 2.2rem);
      letter-spacing: 0.18em;
      color: var(--amber);
      text-shadow: 0 0 12px rgba(243,196,58,.55), 0 0 24px rgba(243,196,58,.25);
      margin-top: -14px;
    }
    .v-matrix .sub-wake .caret {
      display: inline-block;
      width: 14px; height: 22px;
      background: var(--amber);
      margin-left: 4px;
      vertical-align: middle;
      animation: matrix-blink .9s steps(2) infinite;
    }
    @keyframes matrix-blink { 50% { opacity: 0; } }

    /* pill buttons */
    .v-matrix .pills {
      display: flex;
      gap: 30px;
      flex-wrap: wrap;
      justify-content: center;
      margin-top: 6px;
    }
    .v-matrix .pill {
      position: relative;
      padding: 16px 34px 16px 56px;
      border-radius: 6px;
      font-family: 'Share Tech Mono', monospace;
      font-weight: 700;
      font-size: 1.15rem;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      text-decoration: none;
      background: transparent;
      transition: all .22s;
      display: inline-flex;
      align-items: center;
      gap: 10px;
    }
    .v-matrix .pill.blue {
      color: var(--blue);
      border: 2px solid var(--blue);
      text-shadow: 0 0 10px rgba(79,177,255,.6);
      box-shadow: 0 0 0 rgba(79,177,255,.4), inset 0 0 30px rgba(79,177,255,.08);
    }
    .v-matrix .pill.blue::before {
      content: '';
      position: absolute;
      left: 14px;
      width: 26px; height: 26px;
      border-radius: 50%;
      background: radial-gradient(circle at 35% 35%, #9cd6ff 0%, var(--blue) 60%, #1a4a80 100%);
      box-shadow: 0 0 14px rgba(79,177,255,.7);
    }
    .v-matrix .pill.blue:hover { box-shadow: 0 0 28px rgba(79,177,255,.5); background: rgba(79,177,255,.08); }
    .v-matrix .pill.red {
      color: var(--red-glow);
      border: 2px solid var(--red);
      text-shadow: 0 0 10px rgba(255,80,80,.6);
    }
    .v-matrix .pill.red::before {
      content: '';
      position: absolute;
      left: 14px;
      width: 26px; height: 26px;
      border-radius: 50%;
      background: radial-gradient(circle at 35% 35%, #ffa0a0 0%, var(--red) 60%, #701414 100%);
      box-shadow: 0 0 14px rgba(255,80,80,.8);
    }
    .v-matrix .pill.red:hover { box-shadow: 0 0 28px rgba(255,80,80,.5); background: rgba(255,80,80,.08); }

    /* sub-menu green outlined */
    .v-matrix .submenu {
      display: flex;
      gap: 18px;
      flex-wrap: wrap;
      justify-content: center;
    }
    .v-matrix .submenu a {
      padding: 10px 20px 10px 16px;
      border: 1.5px solid var(--green);
      color: var(--green-0);
      text-decoration: none;
      font-family: 'Share Tech Mono', monospace;
      font-weight: 400;
      font-size: 14px;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      background: rgba(0,10,16,.5);
      display: inline-flex;
      align-items: center;
      gap: 10px;
      transition: all .2s;
      text-shadow: 0 0 6px rgba(54,226,106,.5);
    }
    .v-matrix .submenu a:hover {
      background: rgba(54,226,106,.15);
      box-shadow: 0 0 18px rgba(54,226,106,.4);
    }
    .v-matrix .submenu a svg { width: 15px; height: 15px; fill: currentColor; }

    /* description */
    .v-matrix .desc {
      max-width: 720px;
      font-family: 'VT323', monospace;
      font-size: 1.3rem;
      line-height: 1.5;
      color: var(--green);
      text-shadow: 0 0 6px rgba(54,226,106,.35);
      margin-top: 6px;
    }
    .v-matrix .desc b { color: var(--amber); text-shadow: 0 0 8px rgba(243,196,58,.4); }
    .v-matrix .desc em { font-style: normal; color: var(--green-0); }

    /* notify */
    .v-matrix .notify {
      display: flex;
      max-width: 420px;
      width: 100%;
      border: 1.5px solid var(--green);
      box-shadow: 0 0 16px rgba(54,226,106,.25), inset 0 0 20px rgba(54,226,106,.06);
      background: rgba(0,10,16,.75);
    }
    .v-matrix .notify input[type="email"] {
      flex: 1;
      padding: 12px 14px;
      background: transparent;
      border: none;
      outline: none;
      color: var(--green-0);
      font-family: 'Share Tech Mono', monospace;
      font-size: 14px;
      text-shadow: 0 0 6px currentColor;
    }
    .v-matrix .notify input::placeholder { color: rgba(54,226,106,.4); }
    .v-matrix .notify button {
      padding: 12px 20px;
      background: rgba(54,226,106,.12);
      color: var(--green-0);
      border: none;
      border-left: 1.5px solid var(--green);
      font-family: 'Share Tech Mono', monospace;
      font-weight: 700;
      font-size: 12px;
      letter-spacing: 0.28em;
      cursor: pointer;
      text-shadow: 0 0 6px currentColor;
    }

    .v-matrix .privacy-consent {
      font-family: 'Share Tech Mono', monospace;
      font-size: 11px;
      color: var(--text-dim);
      letter-spacing: 0.22em;
      text-transform: uppercase;
      margin-top: 6px;
      max-width: 420px;
      text-shadow: 0 0 4px rgba(54,226,106,.3);
    }
    .v-matrix .privacy-consent a { color: var(--amber); text-decoration: underline; }

    /* ========= SHELL FOOTER ========= */
    .v-matrix .shell {
      position: fixed;
      bottom: 0; left: 0; right: 0;
      z-index: 8;
      padding: 8px 16px 10px;
      font-family: 'Share Tech Mono', monospace;
      font-size: 13px;
      color: var(--green-0);
      background: linear-gradient(180deg, transparent 0%, rgba(0,10,16,.9) 45%);
      display: flex; justify-content: space-between; flex-wrap: wrap; gap: 10px;
      text-shadow: 0 0 4px currentColor;
    }
    .v-matrix .shell b { color: var(--amber); text-shadow: 0 0 6px var(--amber); }
    .v-matrix .shell .prompt::before { content: 'bentoo:~$ '; color: var(--green); }
    .v-matrix .shell .prompt-cursor {
      display: inline-block; width: 10px; height: 14px;
      background: var(--green); vertical-align: -2px;
      animation: matrix-blink .9s steps(2) infinite;
    }

    @media (max-width: 760px) {
      .v-matrix .chrome { padding: 8px 14px; font-size: 10px; gap: 10px; }
      .v-matrix .chrome .search { min-width: 0; flex: 1; }
      .v-matrix .url-bar { padding: 8px 14px; font-size: 11px; }
      .v-matrix main { padding: 14px 16px 120px; gap: 20px; }
      .v-matrix .pill { padding: 12px 24px 12px 48px; font-size: 1rem; }
      .v-matrix .submenu a { font-size: 12px; padding: 8px 14px; }
    }
  </style>

  <div class="v-matrix">
    <!-- Matrix rain canvas -->
    <canvas id="rain"></canvas>

    <!-- Fake browser chrome -->
    <div class="chrome">
      <div class="tabs">
        <span class="tab active">◉ BENTOO Linux</span>
        <span class="tab">Source</span>
        <span class="tab">Distro</span>
      </div>
      <div class="search">⌕ search</div>
    </div>

    <div class="url-bar">
      <span class="dot"></span>
      <div class="addr">⛭ <b>bentoo.io</b> /wake-up/gentoo</div>
    </div>

    <main>
      <div class="wordmark" data-text="BENTOO">BENTOO</div>
      <div class="sub-wake">WAKE UP, GENTOO<span class="caret"></span></div>

      <div class="pills">
        <a class="pill blue" href="https://gentoo.org" target="_blank" rel="noopener">Stay Gentoo</a>
        <a class="pill red" href="#notify">Choose Bentoo</a>
      </div>

      <div class="submenu">
        <a href="https://github.com/obentoo" target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24"><path d="M12 .5C5.65.5.5 5.66.5 12.02c0 5.08 3.29 9.39 7.86 10.91.58.1.79-.25.79-.56 0-.28-.01-1.02-.02-2-3.19.69-3.86-1.54-3.86-1.54-.53-1.33-1.29-1.68-1.29-1.68-1.05-.72.08-.71.08-.71 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.23-1.28-5.23-5.68 0-1.26.45-2.28 1.18-3.08-.12-.29-.51-1.46.11-3.04 0 0 .97-.31 3.17 1.17.92-.26 1.9-.39 2.88-.39.98 0 1.97.13 2.88.39 2.2-1.48 3.16-1.17 3.16-1.17.63 1.58.24 2.75.12 3.04.73.8 1.18 1.82 1.18 3.08 0 4.41-2.69 5.38-5.25 5.67.41.35.77 1.06.77 2.13 0 1.54-.01 2.78-.01 3.16 0 .31.21.67.8.56 4.56-1.52 7.85-5.83 7.85-10.91C23.5 5.66 18.35.5 12 .5z"/></svg>
          GITHUB
        </a>
        <a href="mailto:contact@obentoo.org">
          <svg viewBox="0 0 24 24"><path d="M4 4h16a2 2 0 012 2v12a2 2 0 01-2 2H4a2 2 0 01-2-2V6a2 2 0 012-2zm0 2v.35L12 12l8-5.65V6H4z"/></svg>
          CONTACT
        </a>
        <a href="#notify">
          <svg viewBox="0 0 24 24"><path d="M12 22a2 2 0 002-2h-4a2 2 0 002 2zm6-6V11a6 6 0 00-5-5.92V4a1 1 0 10-2 0v1.08A6 6 0 006 11v5l-2 2v1h16v-1l-2-2z"/></svg>
          NOTIFY ME
        </a>
      </div>

      <p class="desc">
        A <b>minimalist</b>, <em>source-based</em> distribution derived from <em>Gentoo</em>.<br />
        Built for speed and ultimate optimization. Explore the <b>Matrix</b>.
      </p>

      <form
        class="notify"
        id="notify"
        data-bentoo-subscribe
        action={`https://buttondown.com/api/emails/embed-subscribe/${buttondownUser}`}
        method="post"
        data-success-msg={strings.successMsg}
        data-error-msg={strings.errorMsg}
      >
        <input type="hidden" name="embed" value="1" />
        <input type="email" name="email" required placeholder={strings.subscribePlaceholder} />
        <button type="submit">{strings.subscribeButton}</button>
      </form>
      <p class="privacy-consent">
        {strings.privacyConsent} <a href="/privacy">{strings.privacyLinkLabel}</a>
      </p>
    </main>

    <div class="shell">
      <span class="prompt">emerge --sync<span class="prompt-cursor"></span></span>
      <span>© 2024 <b>BENTOO</b> project · Source is power.</span>
    </div>
  </div>

  <script is:inline>
    (function(){
      var c = document.getElementById('rain');
      if (!c) return;
      var ctx = c.getContext('2d');
      var w, h, cols, drops;
      var chars = 'アカサタナハマヤラワガザダバパイキシチニヒミリギジヂビピウクスツヌフムユルグズヅブプエケセテネヘメレゲゼデベペオコソトノホモヨロヲゴゾドボポ0123456789ABCDEFBENTOO';
      function resize() {
        w = c.width = window.innerWidth;
        h = c.height = window.innerHeight;
        cols = Math.floor(w / 16);
        drops = new Array(cols).fill(0).map(function () { return Math.random() * h / 16; });
      }
      resize();
      window.addEventListener('resize', resize);
      function draw() {
        ctx.fillStyle = 'rgba(0,8,12,.075)';
        ctx.fillRect(0, 0, w, h);
        ctx.font = '16px "Share Tech Mono", monospace';
        for (var i = 0; i < cols; i++) {
          var ch = chars[Math.floor(Math.random() * chars.length)];
          var x = i * 16;
          var y = drops[i] * 16;
          if (Math.random() < 0.04) {
            ctx.fillStyle = '#c8ffd5';
            ctx.shadowColor = '#36e26a';
            ctx.shadowBlur = 8;
          } else {
            ctx.fillStyle = 'rgba(54,226,106,.85)';
            ctx.shadowBlur = 0;
          }
          ctx.fillText(ch, x, y);
          if (y > h && Math.random() > 0.975) drops[i] = 0;
          drops[i]++;
        }
      }
      setInterval(draw, 55);
    })();
  </script>
</VariantLayout>
