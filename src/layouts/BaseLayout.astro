---
import { rootUrl, localizedPath, canonicalForVariant } from '~/utils/siteUrl';
import {
  LOCALES,
  DEFAULT_LOCALE,
  htmlLangFor,
  ogLocaleFor,
  hreflangFor,
  type Lang,
} from '~/utils/getLang';
import type { VariantSlug } from '~/data/variants';
import { I18N, stringsFor } from '~/i18n';
import '~/styles/base.css';

export interface Props {
  lang: Lang;
  path: string;
  title: string;
  description: string;
  isVariantPage?: boolean;
  variantSlug?: VariantSlug;
  ogImage?: string;
  noindexOverride?: boolean;
}

const {
  lang,
  path,
  title,
  description,
  isVariantPage = false,
  variantSlug,
  ogImage = '/og/default.png',
  noindexOverride = false,
} = Astro.props;

const htmlLang = htmlLangFor(lang);
const isProduction = import.meta.env.PUBLIC_IS_PRODUCTION === true;
const cfToken = import.meta.env.PUBLIC_CF_ANALYTICS_TOKEN;
const siteRoot = (import.meta.env.PUBLIC_SITE_URL || 'https://bentoo.org').replace(/\/$/, '');

const canonicalHref =
  isVariantPage && variantSlug
    ? canonicalForVariant(variantSlug, lang)
    : rootUrl(lang);

const robotsContent =
  noindexOverride || !isProduction
    ? 'noindex,nofollow'
    : isVariantPage
      ? 'noindex,follow'
      : 'index,follow';

const hreflangLinks = LOCALES.map((l) => ({
  hreflang: hreflangFor(l),
  href: `${siteRoot}${l === DEFAULT_LOCALE ? '/' : `/${l}/`}`,
}));
const xDefaultHref = `${siteRoot}/`;

const ogImageAbs = ogImage.startsWith('http') ? ogImage : `${siteRoot}${ogImage}`;

const inLanguageList = LOCALES.map((l) => htmlLangFor(l));

const jsonLd = !isVariantPage && !noindexOverride
  ? JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'SoftwareApplication',
      name: 'Bentoo',
      alternateName: 'bentoo.org',
      applicationCategory: 'OperatingSystem',
      operatingSystem: 'Linux (Gentoo-based)',
      description,
      url: siteRoot,
      inLanguage: inLanguageList,
    })
  : null;

const strings = stringsFor(lang);
const otherLocales = LOCALES.filter((l) => l !== lang);
const langLinks = otherLocales.map((target) => ({
  target,
  href: localizedPath(path, target),
  label: I18N[target].languageToggleLabel,
  hreflang: hreflangFor(target),
}));
const privacyHref = localizedPath('/privacy', lang);

const langToggleScript = `
try {
  var links = document.querySelectorAll('[data-bentoo-lang-toggle]');
  for (var i = 0; i < links.length; i++) {
    links[i].addEventListener('click', function () {
      try {
        localStorage.setItem('bentoo-lang', this.getAttribute('data-target-lang'));
        localStorage.setItem('bentoo-lang-expires', String(Date.now() + 86400000));
      } catch (e) {}
    });
  }
} catch (e) {}
`.trim();
---
<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/bentoo-logo.svg" />
    <link rel="canonical" href={canonicalHref} />
    <meta name="robots" content={robotsContent} />
    {hreflangLinks.map((l) => (
      <link rel="alternate" hreflang={l.hreflang} href={l.href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={xDefaultHref} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Bentoo" />
    <meta property="og:locale" content={ogLocaleFor(lang)} />
    {otherLocales.map((l) => (
      <meta property="og:locale:alternate" content={ogLocaleFor(l)} />
    ))}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalHref} />
    <meta property="og:image" content={ogImageAbs} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbs} />
    {jsonLd && <script type="application/ld+json" is:inline set:html={jsonLd} />}
    {isProduction && cfToken && (
      <script
        is:inline
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={`{"token": "${cfToken}"}`}
      ></script>
    )}
    <slot name="head-extra" />
    <slot name="style" />
  </head>
  <body>
    <slot />
    <footer class="bentoo-footer">
      {langLinks.map((l, i) => (
        <>
          <a
            href={l.href}
            data-bentoo-lang-toggle
            data-target-lang={l.target}
            rel="alternate"
            hreflang={l.hreflang}
          >{l.label}</a>
          {i < langLinks.length - 1 ? <span class="bentoo-footer-sep">·</span> : null}
        </>
      ))}
      <span class="bentoo-footer-sep">·</span>
      <a href={privacyHref}>{strings.privacyLinkLabel}</a>
      <span class="bentoo-footer-sep">·</span>
      <span class="bentoo-footer-copy">{strings.footerCopyright}</span>
    </footer>
    <script is:inline set:html={langToggleScript} />
  </body>
</html>
