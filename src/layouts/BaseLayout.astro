---
import { rootUrl, canonicalForVariant, siteOrigin, pageUrl, localizedPath } from '~/utils/siteUrl';
import {
  LOCALES,
  DEFAULT_LOCALE,
  htmlLangFor,
  ogLocaleFor,
  hreflangFor,
  type Lang,
} from '~/utils/getLang';
import type { VariantSlug } from '~/data/variants';
import '~/styles/base.css';

export interface Props {
  lang: Lang;
  path: string;
  title: string;
  description: string;
  isVariantPage?: boolean;
  variantSlug?: VariantSlug;
  ogImage?: string;
  noindexOverride?: boolean;
  /**
   * Build canonical, og:url and the hreflang alternates from `path` instead of
   * the locale root. Opt-in so the pages that predate it (roots, privacy,
   * variants, 404) keep their output byte for byte.
   */
  canonicalFromPath?: boolean;
  /**
   * Emit the SoftwareApplication JSON-LD. Off for pages about something other
   * than the application itself (notices), whose description is author text.
   */
  structuredData?: boolean;
}

const {
  lang,
  path,
  title,
  description,
  isVariantPage = false,
  variantSlug,
  ogImage = '/og/default.png',
  noindexOverride = false,
  canonicalFromPath = false,
  structuredData = true,
} = Astro.props;

const htmlLang = htmlLangFor(lang);
const isProduction = import.meta.env.PUBLIC_IS_PRODUCTION === true;
const cfToken = import.meta.env.PUBLIC_CF_ANALYTICS_TOKEN;
const siteRoot = siteOrigin();

// Without canonicalFromPath every page declares its locale root canonical,
// which is right for the roots and variants but would make search engines
// drop any page with content of its own (story 002, R5.3).
const canonicalHref = canonicalFromPath
  ? pageUrl(localizedPath(path, lang))
  : isVariantPage && variantSlug
    ? canonicalForVariant(variantSlug, lang)
    : rootUrl(lang);

const robotsContent =
  noindexOverride || !isProduction
    ? 'noindex,nofollow'
    : isVariantPage
      ? 'noindex,follow'
      : 'index,follow';

const hreflangLinks = LOCALES.map((l) => ({
  hreflang: hreflangFor(l),
  href: canonicalFromPath
    ? pageUrl(localizedPath(path, l))
    : `${siteRoot}${l === DEFAULT_LOCALE ? '/' : `/${l}/`}`,
}));
const xDefaultHref = canonicalFromPath
  ? pageUrl(localizedPath(path, DEFAULT_LOCALE))
  : `${siteRoot}/`;

const ogImageAbs = ogImage.startsWith('http') ? ogImage : `${siteRoot}${ogImage}`;

const inLanguageList = LOCALES.map((l) => htmlLangFor(l));

// `<` is escaped so no string can close the inline <script> (set:html below).
const jsonLd = structuredData && !isVariantPage && !noindexOverride
  ? JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'SoftwareApplication',
      name: 'Bentoo',
      alternateName: 'obentoo.org',
      applicationCategory: 'OperatingSystem',
      operatingSystem: 'Linux (Gentoo-based)',
      description,
      url: siteRoot,
      inLanguage: inLanguageList,
    }).replace(/</g, '\\u003c')
  : null;

const otherLocales = LOCALES.filter((l) => l !== lang);
---
<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/bentoo-logo.svg" />
    <link rel="canonical" href={canonicalHref} />
    <meta name="robots" content={robotsContent} />
    {hreflangLinks.map((l) => (
      <link rel="alternate" hreflang={l.hreflang} href={l.href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={xDefaultHref} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Bentoo" />
    <meta property="og:locale" content={ogLocaleFor(lang)} />
    {otherLocales.map((l) => (
      <meta property="og:locale:alternate" content={ogLocaleFor(l)} />
    ))}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalHref} />
    <meta property="og:image" content={ogImageAbs} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbs} />
    {jsonLd && <script type="application/ld+json" is:inline set:html={jsonLd} />}
    {isProduction && cfToken && (
      <script
        is:inline
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={`{"token": "${cfToken}"}`}
      ></script>
    )}
    <slot name="head-extra" />
    <slot name="style" />
  </head>
  <body>
    <slot />
  </body>
</html>
