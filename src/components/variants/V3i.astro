  <main>

    <div class="win install-win">
      <div class="win-bar">
        <span class="title">bentoo — install.exe</span>
        <span class="ctls"><b>_</b><b>□</b><b>×</b></span>
      </div>
      <div class="win-menu"><span><u>{content.winMenuFile}</u>{content.fileMenuLabel}</span><span><u>{content.winMenuEdit}</u>{content.editMenuLabel}</span><span><u>{content.winMenuOptions}</u>ptions</span><span><u>{content.winMenuHelp}</u>{content.helpMenuLabel}</span></div>
      <div class="win-body">

        <div class="wiz-sub" set:html={content.wizWelcomeHtml}></div>
        <h1>BENT<em>OO</em><span class="period">.</span></h1>
        <div class="tagline" set:html={content.taglineHtml}></div>

        <p class="brief" set:html={content.ledeHtml}></p>

        <div class="box-list">
          {content.specs.map((row) => (
            <div class="row"><span class="k">{row.k}</span><span class="v">{row.v}</span><span class="t">{row.t}</span></div>
          ))}
        </div>

        <div class="progress-wrap">
          <div class="progress-label-top" set:html={content.progressTopLabelHtml}></div>
          <div class="progress">
