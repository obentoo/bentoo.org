  <script is:inline set:html={V3I_SCRIPT}></script>
  <script is:inline>
    document.addEventListener('click', function(e){
      var b = e.target.closest('[data-bentoo-back]');
      if (b) { history.back(); return; }
      var f = e.target.closest('[data-bentoo-focus-input]');
      if (f) {
        var id = f.getAttribute('data-bentoo-focus-input');
        var el = id && document.getElementById(id);
        if (el && typeof el.focus === 'function') el.focus();
      }
    });
  </script>
