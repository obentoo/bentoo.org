---
import VariantLayout from '~/layouts/VariantLayout.astro';
import type { Lang } from '~/utils/getLang';
import { stringsFor } from '~/i18n';
import { v3j } from '~/i18n/variants/v3j';
import { localizedPath } from '~/utils/siteUrl';

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const content = v3j[lang];
const strings = stringsFor(lang);
const path = localizedPath('/v/v3j/', lang);
const privacyHref = localizedPath('/privacy', lang);
const buttondownUser = import.meta.env.PUBLIC_BUTTONDOWN_USERNAME ?? 'bentoo';

// v3j — IRIX 6.5 xterm shell. Localized strings injected via JSON.stringify
// at build time. Visitor input passes through esc() before being inserted.
const SHELL_I18N = JSON.stringify(content.shell);
const V3J_SCRIPT = `
(function(){
  var I = ${SHELL_I18N};
  var clockEl = document.getElementById('clock');
  var DAYS = ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];
  var MONTHS = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
  var pad = function(n){ return String(n).padStart(2,'0'); };
  function tick(){
    if (!clockEl) return;
    var d = new Date();
    clockEl.textContent = DAYS[d.getDay()] + ' ' + MONTHS[d.getMonth()] + ' ' + pad(d.getDate()) + ' · ' + pad(d.getHours()) + ':' + pad(d.getMinutes()) + ':' + pad(d.getSeconds()) + ' ' + (Intl.DateTimeFormat().resolvedOptions().timeZone.split('/').pop() || 'LOCAL') + ' ' + d.getFullYear();
  }
  tick(); setInterval(tick, 1000);

  var out = document.getElementById('xout');
  var inp = document.getElementById('xinput');
  var xterm = document.getElementById('xterm');
  if (!out || !inp || !xterm) return;
  var cmdHistory = [];
  var histIdx = -1;

  function esc(s){ return String(s).replace(/[&<>]/g, function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;'}[c];}); }
  function render(html, cls){
    var wrapper = cls ? '<div class="'+cls+'">' : '<div>';
    var markup = wrapper + String(html).replace(/\\n/g, '<br>') + '</div>';
    out.insertAdjacentHTML('beforeend', markup);
    xterm.scrollTop = xterm.scrollHeight;
  }
  function promptLine(cmd){
    render('<span class="ps">root@obentoo</span>:<span class="kw">~</span># ' + esc(cmd));
  }

  var commands = {
    'help': function(){ return I.helpLines.join('\\n'); },
    'ls': function(){ return [
      '<span class="kw">boot</span>   <span class="kw">etc</span>    <span class="kw">home</span>   <span class="kw">opt</span>    <span class="kw">usr</span>    <span class="kw">var</span>',
      'bentoo-release  world.conf  stage3.tar.xz'
    ].join('\\n'); },
    'pwd': function(){ return '/root'; },
    'whoami': function(){ return I.whoami; },
    'uname -a': function(){ return I.unameLong; },
    'uname': function(){ return I.unameShort; },
    'date': function(){ return new Date().toString(); },
    'emerge --info': function(){ return I.emergeInfoLines.join('\\n'); },
    'emerge': function(){ return I.emergeUsage; },
    'cat /etc/os-release': function(){ return I.osReleaseLines.join('\\n'); },
    'neofetch': function(){ return I.neofetchLines.join('\\n'); },
    'fortune': function(){ return I.fortuneQuotes[Math.floor(Math.random() * I.fortuneQuotes.length)]; },
    'banana': function(){ return I.bananaLines.join('\\n'); },
    'clear': function(){ out.textContent = ''; return null; },
    'exit': function(){ return I.exitMsg; },
    'logout': function(){ return I.logoutMsg; },
    'sudo rm -rf /': function(){ return I.sudoRmMsg; },
    'sudo rm -rf /*': function(){ return I.sudoRmMsg; },
    ':(){ :|:& };:': function(){ return I.forkBombMsg; }
  };

  function run(raw){
    var cmd = raw.trim();
    if (!cmd) return;
    promptLine(cmd);
    cmdHistory.push(cmd); histIdx = cmdHistory.length;
    if (cmd.indexOf('cowsay ') === 0){
      var msg = cmd.slice(7) || 'moo';
      var top = ' ' + '_'.repeat(msg.length + 2);
      var mid = '< ' + esc(msg) + ' >';
      var bot = ' ' + '-'.repeat(msg.length + 2);
      render([top, mid, bot, '        \\\\   ^__^', '         \\\\  (oo)\\\\_______', '            (__)\\\\       )\\\\/\\\\', '                ||----w |', '                ||     ||'].map(function(l){return '<span class="ascii">' + esc(l) + '</span>';}).join('\\n'));
      return;
    }
    var fn = commands[cmd] || commands[cmd.toLowerCase()];
    if (fn){
      var res = fn();
      if (res !== null && res !== undefined) render(res);
      return;
    }
    render('<span class="ps">' + esc(cmd.split(' ')[0]) + '</span>' + I.commandNotFoundSuffix);
  }

  inp.addEventListener('keydown', function(e){
    if (e.key === 'Enter'){
      run(inp.value);
      inp.value = '';
    } else if (e.key === 'ArrowUp'){
      if (histIdx > 0){ histIdx--; inp.value = cmdHistory[histIdx]; }
      e.preventDefault();
    } else if (e.key === 'ArrowDown'){
      if (histIdx < cmdHistory.length - 1){ histIdx++; inp.value = cmdHistory[histIdx]; }
      else { histIdx = cmdHistory.length; inp.value = ''; }
      e.preventDefault();
    } else if (e.ctrlKey && e.key === 'l'){
      out.textContent = ''; e.preventDefault();
    }
  });
})();
`.trim();
---
<VariantLayout
  lang={lang}
  path={path}
  title={content.title}
  description={content.description}
  variantSlug="v3j"
>
  <Fragment slot="head-extra">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;700&family=IBM+Plex+Sans:wght@400;500;700&family=VT323&display=swap" rel="stylesheet" />
  </Fragment>
  <style slot="style">
    *,*::before,*::after{margin:0;padding:0;box-sizing:border-box}
    :root{
      --desk:#3a2d3a; --desk-2:#2c2430; --desk-3:#1c161e;
      --motif:#9b95a3; --motif-2:#b5afbc; --motif-l:#dcd5e3;
      --motif-d:#5d555f; --motif-dd:#2b262e;
      --teal:#2a6b6b; --teal-2:#1f5757; --teal-l:#5ba09d;
      --amber:#ffb13a; --green:#5ac65a; --red:#d94838;
      --ink:#0f0d10; --paper:#d9d2df;
      --f-sans:'IBM Plex Sans',sans-serif;
      --f-mono:'IBM Plex Mono',monospace;
      --f-crt:'VT323',monospace;
    }
    html,body{background:var(--desk);color:var(--ink);font-family:var(--f-sans);font-size:13px;min-height:100vh;line-height:1.4;display:flex;flex-direction:column}
    body{
      background-color:var(--desk);
      background-image:
        radial-gradient(circle at 20% 30%,rgba(0,0,0,.2) 0%,transparent 50%),
        radial-gradient(circle at 80% 70%,rgba(0,0,0,.2) 0%,transparent 50%);
      overflow-x:hidden;
    }
    body::before{
      content:'';position:fixed;inset:0;pointer-events:none;z-index:999;
      background-image:repeating-linear-gradient(90deg,transparent 0 2px,rgba(0,0,0,.08) 2px 3px);
      mix-blend-mode:multiply;opacity:.5;
    }
    a{color:inherit;text-decoration:none}

    .cde-bar{
      position:sticky;top:0;z-index:60;
      background:linear-gradient(180deg,var(--motif-2),var(--motif));
      border-bottom:2px solid var(--motif-dd);
      padding:5px 14px;
      display:flex;gap:14px;align-items:center;
      box-shadow:0 2px 6px rgba(0,0,0,.3);
      font-family:var(--f-sans);font-size:12px;
    }
    .cde-bar .hostname{
      background:var(--motif);border:2px inset var(--motif-d);
      padding:2px 10px;font-family:var(--f-mono);color:var(--teal-2);font-weight:700;
    }
    .cde-bar .load{font-family:var(--f-mono);color:#000;font-size:11px;font-weight:600}
    .cde-bar .load .lbl{color:#000;font-weight:700}
    .cde-bar .load b{color:var(--green);font-weight:700}
    .cde-bar .load .r{color:var(--red)}
    .cde-bar .kernel-info{font-family:var(--f-mono);font-size:11px;color:#000;font-weight:600}
    .cde-bar .kernel-info b{color:var(--red);font-weight:700}
    .cde-bar .clock{
      margin-left:auto;
      font-family:var(--f-mono);font-size:12px;
      background:var(--ink);color:var(--amber);padding:2px 10px;
      border:2px inset var(--motif-d);
    }

    .motif-banner{
      background:linear-gradient(180deg,var(--teal-l),var(--teal-2));
      color:#fff;
      padding:8px 0;
      overflow:hidden;white-space:nowrap;
      font-family:var(--f-mono);font-size:12px;letter-spacing:.14em;
      border-top:2px solid var(--motif-l);
      border-bottom:2px solid var(--motif-dd);
      box-shadow:inset 0 1px 0 rgba(255,255,255,.25);
    }
    .mq{display:inline-flex;gap:48px;animation:scroll 60s linear infinite;padding-left:48px;width:max-content}
    .mq span{display:inline-flex;gap:12px;align-items:center}
    .mq i{color:var(--amber);font-style:normal;font-weight:700}
    @keyframes scroll{to{transform:translate3d(-50%,0,0)}}

    .desktop{flex:1;padding:28px 20px 90px;max-width:900px;margin:0 auto;width:100%;position:relative;z-index:2}

    .win{
      background:var(--motif);
      border-top:2px solid var(--motif-l);
      border-left:2px solid var(--motif-l);
      border-right:2px solid var(--motif-dd);
      border-bottom:2px solid var(--motif-dd);
      box-shadow:
        inset -1px -1px 0 var(--motif-d),
        inset 1px 1px 0 var(--motif-l),
        4px 4px 10px rgba(0,0,0,.5);
      margin-bottom:14px;
    }
    .win-title{
      background:linear-gradient(180deg,var(--teal-l),var(--teal) 15%,var(--teal-2) 100%);
      color:#fff;
      padding:5px 10px;
      display:flex;justify-content:space-between;align-items:center;
      font-family:var(--f-sans);font-size:12px;font-weight:500;
      letter-spacing:.03em;
      border-bottom:2px solid var(--motif-dd);
      box-shadow:inset 0 1px 0 rgba(255,255,255,.3);
    }
    .win-title .n{font-weight:600;letter-spacing:.02em;display:inline-flex;align-items:center;gap:8px}
    .win-title .n::before{
      content:'';display:inline-block;width:14px;height:14px;
      background:linear-gradient(180deg,var(--motif-l),var(--motif) 50%,var(--motif-d));
      border:2px outset var(--motif-d);
    }
    .win-title .ctls{display:flex;gap:4px}
    .win-title .ctls b{
      display:inline-grid;place-items:center;
      width:20px;height:16px;
      background:var(--motif);
      border-top:1.5px solid var(--motif-l);
      border-left:1.5px solid var(--motif-l);
      border-right:1.5px solid var(--motif-dd);
      border-bottom:1.5px solid var(--motif-dd);
      font-family:var(--f-mono);font-size:10px;color:var(--ink);font-weight:500;
      cursor:pointer;
    }
    .win-menubar{
      background:var(--motif);
      border-bottom:1px solid var(--motif-dd);
      padding:4px 10px;
      display:flex;gap:18px;
      font-family:var(--f-sans);font-size:12px;
      box-shadow:inset 0 -1px 0 var(--motif-l);
    }
    .win-menubar span{padding:1px 4px;cursor:default}
    .win-menubar span u{text-decoration:underline}
    .win-menubar .help{margin-left:auto}
    .win-body{padding:18px 22px;background:var(--motif);color:var(--ink)}

    .pkg-win h1{
      font-family:var(--f-sans);font-weight:700;
      font-size:clamp(40px,6vw,62px);
      line-height:.95;letter-spacing:-.02em;color:var(--ink);
      margin-bottom:8px;
    }
    .pkg-win h1 em{font-style:normal;color:var(--teal-2)}
    .pkg-win h1 .period{color:var(--red)}
    .pkg-win .sub{
      font-family:var(--f-mono);font-size:12px;
      color:var(--teal-2);letter-spacing:.1em;
      margin-bottom:14px;text-transform:uppercase;
      display:flex;gap:10px;align-items:baseline;flex-wrap:wrap;
    }
    .pkg-win .sub b{color:var(--red)}
    .pkg-win .tagline{
      font-family:var(--f-sans);font-weight:700;
      font-size:clamp(16px,1.6vw,19px);
      color:var(--ink);letter-spacing:-.01em;
      margin-bottom:16px;line-height:1.35;
    }
    .pkg-win .tagline em{font-style:italic;font-weight:600;color:var(--teal-2)}

    .pkg-win .desc{
      font-family:var(--f-sans);font-size:14px;line-height:1.55;color:var(--ink);
      margin-bottom:16px;
      padding:12px 14px;
      background:var(--motif-l);
      border:1px inset var(--motif-d);
      max-width:620px;
    }
    .pkg-win .desc b{color:var(--teal-2)}
    .pkg-win .desc em{font-style:italic;color:var(--red);font-weight:500}

    .spec-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:16px;max-width:620px}
    .spec{
      background:var(--paper);
      border:2px inset var(--motif-d);
      padding:8px 12px;
      font-family:var(--f-mono);font-size:11px;
    }
    .spec .k{color:var(--teal-2);font-weight:700;letter-spacing:.08em;text-transform:uppercase;font-size:9px;display:block;margin-bottom:2px}
    .spec .v{color:var(--ink);font-size:13px}
    .spec .v em{font-style:normal;color:var(--red);font-weight:600}

    .pkg-actions{display:flex;gap:10px;flex-wrap:wrap;align-items:stretch;max-width:620px}
    .btn-motif{
      background:var(--motif);
      border-top:2px solid var(--motif-l);
      border-left:2px solid var(--motif-l);
      border-right:2px solid var(--motif-dd);
      border-bottom:2px solid var(--motif-dd);
      padding:9px 18px;
      display:inline-flex;align-items:center;gap:10px;
      font-family:var(--f-sans);font-weight:500;font-size:13px;color:var(--ink);
      cursor:pointer;
      box-shadow:inset 1px 1px 0 var(--motif-l);
    }
    .btn-motif:hover{background:var(--motif-2)}
    .btn-motif:active{
      border-top:2px solid var(--motif-dd);
      border-left:2px solid var(--motif-dd);
      border-right:2px solid var(--motif-l);
      border-bottom:2px solid var(--motif-l);
    }
    .btn-motif.pri{background:linear-gradient(180deg,var(--teal-l),var(--teal));color:#fff;font-weight:700}
    .btn-motif .arr{color:var(--amber);text-shadow:1px 1px 0 rgba(0,0,0,.4)}

    .notify-win .win-body{padding:14px 16px}
    .notify-form{display:flex;gap:6px;max-width:620px;margin-bottom:8px}
    .notify-form input{
      flex:1;padding:8px 12px;
      background:var(--paper);
      border-top:2px solid var(--motif-dd);
      border-left:2px solid var(--motif-dd);
      border-right:2px solid var(--motif-l);
      border-bottom:2px solid var(--motif-l);
      font-family:var(--f-mono);font-size:12px;color:var(--ink);
      outline:none;
    }
    .notify-form input:focus{background:#fff}
    .notify-note{
      font-family:var(--f-mono);font-size:10px;color:var(--teal-2);
      letter-spacing:.08em;text-transform:uppercase;
    }
    .notify-note b{color:var(--green);font-weight:700}

    .privacy-consent{
      margin-top:10px;font-family:var(--f-mono);font-size:10px;color:var(--teal-2);
      letter-spacing:.08em;text-transform:uppercase;
    }
    .privacy-consent a{color:var(--red);text-decoration:underline}

    .xterm-win .win-body{padding:0}
    .xterm{
      background:#000;color:#6ff24a;
      font-family:var(--f-mono);font-size:12px;line-height:1.7;
      padding:14px 16px;
      border:2px inset var(--motif-d);
      min-height:220px;position:relative;overflow:auto;
    }
    .xterm::before{
      content:'';position:absolute;inset:0;pointer-events:none;
      background:repeating-linear-gradient(0deg,transparent 0 2px,rgba(111,242,74,.04) 2px 3px);
    }
    .xterm .cmt{color:#f2d550;opacity:.85}
    .xterm .kw{color:#73d5ff;font-weight:700}
    .xterm .str{color:#e08cdf}
    .xterm .ok{color:#6ff24a}
    .xterm .ok::before{content:'✓ '}
    .xterm .ps{color:#ff7857}
    .xterm .cur{display:inline-block;width:8px;height:14px;background:#6ff24a;vertical-align:middle;animation:blink 1s step-end infinite;margin-left:4px}
    @keyframes blink{50%{opacity:0}}
    .xterm-out{position:relative;z-index:1}
    .xterm-out > div{margin-bottom:1px}
    .xterm-line{position:relative;z-index:1;display:flex;align-items:center;gap:6px}
    .xterm-line .pmt{white-space:nowrap}
    .xterm-line input{
      flex:1;background:transparent;border:none;outline:none;caret-color:#6ff24a;
      font-family:var(--f-mono);font-size:12px;color:#6ff24a;line-height:1.7;
      padding:0;
    }
    .xterm-line input::selection{background:#6ff24a;color:#000}
    .ascii{color:#73d5ff;white-space:pre;font-family:var(--f-mono);font-size:11px;line-height:1.15}
    .ascii em{color:#e08cdf;font-style:normal}
    .ascii b{color:#ff7857;font-weight:700}

    .panel{
      position:fixed;bottom:0;left:0;right:0;z-index:80;
      background:linear-gradient(180deg,var(--motif-2),var(--motif) 50%,var(--motif-d));
      border-top:3px solid var(--motif-l);
      box-shadow:0 -4px 12px rgba(0,0,0,.4);
      padding:6px 14px;
      display:flex;align-items:center;gap:10px;
    }
    .panel .logo{
      font-family:var(--f-sans);font-weight:700;font-size:18px;
      color:var(--teal-2);letter-spacing:-.02em;
      padding:4px 10px;
      background:var(--motif);
      border:2px inset var(--motif-d);
      margin-right:6px;
      display:inline-flex;align-items:baseline;
    }
    .panel .logo em{font-style:italic;font-weight:400;color:var(--ink)}
    .panel .logo .dot{color:var(--red)}
    .panel .pbtn{
      display:flex;flex-direction:column;align-items:center;gap:2px;
      background:var(--motif);
      border-top:2px solid var(--motif-l);
      border-left:2px solid var(--motif-l);
      border-right:2px solid var(--motif-dd);
      border-bottom:2px solid var(--motif-dd);
      padding:5px 12px;min-width:70px;
      font-family:var(--f-sans);font-size:10px;color:var(--ink);font-weight:500;
      letter-spacing:.04em;cursor:pointer;text-decoration:none;
    }
    .panel .pbtn:hover{background:var(--motif-2)}
    .panel .pbtn .ic{font-family:var(--f-sans);font-weight:700;font-size:14px;color:var(--teal-2)}
    .panel .workspaces{
      margin-left:auto;
      display:flex;align-items:center;gap:6px;
      background:var(--motif);
      border:2px inset var(--motif-d);
      padding:5px 8px;
    }
    .panel .ws{
      width:26px;height:22px;
      background:var(--motif);
      border:2px outset var(--motif-d);
      display:grid;place-items:center;
      font-family:var(--f-mono);font-size:10px;cursor:pointer;
    }
    .panel .ws.active{background:var(--teal);color:#fff;border:2px inset var(--motif-d)}
    .panel .ws-lbl{font-family:var(--f-sans);font-size:10px;color:var(--teal-2);text-transform:uppercase;letter-spacing:.1em;margin-right:4px;font-weight:700}

    .status-foot{
      background:var(--motif);
      border-top:2px solid var(--motif-l);
      padding:5px 14px;
      margin-top:4px;
      display:flex;justify-content:space-between;align-items:center;
      font-family:var(--f-mono);font-size:11px;
    }
    .status-foot .ok{background:var(--paper);border:1px inset var(--motif-d);padding:2px 10px;color:var(--green);font-weight:700;letter-spacing:.05em}
    .status-foot a{color:var(--teal-2);text-decoration:underline}
    .status-foot a:hover{color:var(--red)}

    @media (max-width:760px){
      .cde-bar{flex-wrap:wrap;gap:8px}
      .cde-bar .load{font-size:10px}
      .spec-grid{grid-template-columns:1fr 1fr}
      .pkg-win h1{font-size:42px}
      .notify-form{flex-direction:column}
      .panel{flex-wrap:wrap}
      .panel .workspaces{display:none}
    }
  </style>

  <div class="cde-bar">
    <span class="hostname">guest@obentoo:~$</span>
    <span class="load"><span class="lbl">load:</span> <b>0.42</b>&nbsp;&nbsp;<span class="lbl">mem:</span> <b>22G/32G</b>&nbsp;&nbsp;<span class="lbl">ebuilds:</span> <b>30,412</b></span>
    <span class="kernel-info"><span class="lbl">kernel:</span> <b>6.19.12-LTS</b></span>
    <span class="clock" id="clock">Fri Apr 20 · 15:23:04 JST 2026</span>
  </div>

  <div class="motif-banner" aria-hidden="true">
    <div class="mq">
      <span><i>源</i> source-based linux</span>
      <span><i>常</i> rolling release</span>
      <span><i>包</i> 100+ new ebuilds</span>
      <span><i>守</i> desktop ready</span>
      <span><i>速</i> -march=x86-64-v3</span>
      <span><i>自</i> daily driver</span>
      <span><i>選</i> opinionated defaults</span>
      <span><i>味</i> gentoo inside</span>
      <span><i>源</i> source-based linux</span>
      <span><i>常</i> rolling release</span>
      <span><i>包</i> 100+ new ebuilds</span>
      <span><i>守</i> desktop ready</span>
      <span><i>速</i> -march=x86-64-v3</span>
      <span><i>自</i> daily driver</span>
      <span><i>選</i> opinionated defaults</span>
      <span><i>味</i> gentoo inside</span>
    </div>
  </div>

  <div class="desktop">

    <div class="win pkg-win">
      <div class="win-title">
        <span class="n">{content.pkgWinTitle}</span>
        <span class="ctls"><b>_</b><b>□</b><b>×</b></span>
      </div>
      <div class="win-menubar">
        <span><u>F</u>ile</span><span><u>E</u>dit</span><span><u>V</u>iew</span>
        <span><u>P</u>ackages</span><span><u>T</u>ools</span><span class="help"><u>H</u>elp</span>
      </div>
      <div class="win-body">
        <h1>bent<em>oo</em><span class="period">.</span></h1>
        <div class="sub" set:html={content.releasePillHtml}></div>
        <div class="tagline" set:html={content.taglineHtml}></div>

        <div class="desc" set:html={content.descHtml}></div>

        <div class="spec-grid">
          {content.specs.map((s) => (
            <div class="spec"><span class="k">{s.k}</span><span class="v" set:html={s.v}></span></div>
          ))}
        </div>

        <div class="pkg-actions">
          <a class="btn-motif pri" href="https://github.com/obentoo" target="_blank" rel="noopener">
            <span class="arr">▶</span> {content.btnGitHub}
          </a>
          <a class="btn-motif" href="mailto:contact@obentoo.org">
            <span class="arr">✉</span> {content.btnContact}
          </a>
          <a class="btn-motif" href="#notify">
            <span class="arr">▶</span> {content.btnNotify}
          </a>
        </div>
      </div>
    </div>

    <div class="win notify-win" id="notify">
      <div class="win-title">
        <span class="n">{content.notifyWinTitle}</span>
        <span class="ctls"><b>_</b><b>□</b><b>×</b></span>
      </div>
      <div class="win-body">
        <form
          class="notify-form"
          data-bentoo-subscribe
          action={`https://buttondown.com/api/emails/embed-subscribe/${buttondownUser}`}
          method="post"
          data-success-msg={strings.successMsg}
          data-error-msg={strings.errorMsg}
        >
          <input type="hidden" name="embed" value="1" />
          <input type="email" name="email" required placeholder={strings.subscribePlaceholder} />
          <button class="btn-motif pri" type="submit"><span class="arr">▶</span> {strings.subscribeButton}</button>
        </form>
        <div class="notify-note" set:html={content.notifyNoteHtml}></div>
        <p class="privacy-consent">
          {strings.privacyConsent} <a href={privacyHref}>{strings.privacyLinkLabel}</a>
        </p>
      </div>
    </div>

    <div class="win xterm-win">
      <div class="win-title">
        <span class="n">{content.xtermWinTitle}</span>
        <span class="ctls"><b>_</b><b>□</b><b>×</b></span>
      </div>
      <div class="xterm" id="xterm" data-bentoo-focus-input="xinput">
        <div class="xterm-out" id="xout">
          <div><span class="ok">{content.shell.welcomeBanner}</span></div>
          <div class="cmt" set:html={content.shell.hintComment}></div>
          <div>&nbsp;</div>
        </div>
        <div class="xterm-line">
          <span class="pmt"><span class="ps">root@obentoo</span>:<span class="kw">~</span>#</span>
          <input id="xinput" type="text" autocomplete="off" spellcheck="false" autofocus aria-label={content.shell.inputAriaLabel} />
        </div>
      </div>
    </div>

    <div class="status-foot">
      <span class="ok">READY</span>
      <span>
        <a href="https://github.com/obentoo" target="_blank" rel="noopener">github.com/obentoo</a>
        &nbsp;·&nbsp;
        <a href="mailto:contact@obentoo.org">contact@obentoo.org</a>
      </span>
      <span>{content.statusFootCopy}</span>
    </div>
  </div>

  <div class="panel">
    <div class="logo">bent<em>oo</em><span class="dot">.</span></div>
    <a class="pbtn" href="https://github.com/obentoo" target="_blank" rel="noopener"><span class="ic">G</span>GitHub</a>
    <a class="pbtn" href="mailto:contact@obentoo.org"><span class="ic">✉</span>Mail</a>
    <a class="pbtn" href="#notify"><span class="ic">!</span>Notify</a>
    <div class="workspaces">
      <span class="ws-lbl">WS</span>
      <span class="ws active">1</span>
      <span class="ws">2</span>
      <span class="ws">3</span>
      <span class="ws">4</span>
    </div>
  </div>

  <script is:inline set:html={V3J_SCRIPT}></script>
  <script is:inline>
    document.addEventListener('click', function(e){
      var f = e.target.closest('[data-bentoo-focus-input]');
      if (f) {
        var id = f.getAttribute('data-bentoo-focus-input');
        var el = id && document.getElementById(id);
        if (el && typeof el.focus === 'function') el.focus();
      }
    });
  </script>
</VariantLayout>
</content>
</invoke>