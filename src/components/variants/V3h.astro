---
import VariantLayout from '~/layouts/VariantLayout.astro';
import type { Lang } from '~/utils/getLang';
import { stringsFor } from '~/i18n';
import { v3h } from '~/i18n/variants/v3h';
import { localizedPath } from '~/utils/siteUrl';

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const content = v3h[lang];
const strings = stringsFor(lang);
const path = localizedPath('/v/v3h/', lang);
const privacyHref = localizedPath('/privacy', lang);
const buttondownUser = import.meta.env.PUBLIC_BUTTONDOWN_USERNAME ?? 'bentoo';
const tickerSpansDoubled = [...content.tickerSpans, ...content.tickerSpans];
---
<VariantLayout
  lang={lang}
  path={path}
  title={content.title}
  description={content.description}
  variantSlug="v3h"
>
  <Fragment slot="head-extra">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Michroma&family=Audiowide&family=VT323&family=Zen+Kaku+Gothic+New:wght@500;700;900&family=Noto+Serif+JP:wght@700;900&family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet" />
  </Fragment>
  <style slot="style">
    *,*::before,*::after{margin:0;padding:0;box-sizing:border-box}
    :root{
      --bg:#070509; --bg-2:#0d0915; --bg-3:#16101f;
      --pink:#ff3ea8; --pink-2:#ff7cc7;
      --cyan:#3ee0ff; --cyan-2:#8ff1ff;
      --green:#a7ff3b; --orange:#ff9134; --red:#ff2a2a;
      --white:#f2eaf8;
      --f-chrome:'Audiowide',sans-serif;
      --f-mich:'Michroma',sans-serif;
      --f-jp:'Zen Kaku Gothic New',sans-serif;
      --f-ser:'Noto Serif JP',serif;
      --f-mono:'JetBrains Mono',monospace;
      --f-crt:'VT323',monospace;
    }
    html,body{background:var(--bg);color:var(--white);font-family:var(--f-jp);font-weight:500;font-size:15px;min-height:100vh;line-height:1.5;display:flex;flex-direction:column}
    body{
      background:
        radial-gradient(900px 500px at 80% 10%,rgba(62,224,255,.1),transparent 70%),
        radial-gradient(900px 500px at 20% 80%,rgba(255,62,168,.1),transparent 70%),
        var(--bg);
      overflow-x:hidden;
    }
    body::before{
      content:'';position:fixed;inset:0;pointer-events:none;z-index:1000;
      background:repeating-linear-gradient(0deg,transparent 0 2px,rgba(0,0,0,.3) 2px 3px);
      mix-blend-mode:multiply;
    }
    a{color:inherit;text-decoration:none}

    .top-bar{
      position:relative;z-index:10;
      background:linear-gradient(90deg,transparent,var(--bg-2),transparent);
      border-bottom:1px solid rgba(62,224,255,.3);
      padding:10px 28px;
      display:flex;justify-content:space-between;align-items:center;
      font-family:var(--f-mich);font-size:10px;letter-spacing:.28em;
    }
    .top-bar .brand{color:var(--pink)}
    .top-bar .brand em{color:var(--cyan);font-style:normal}
    .top-bar .clk{color:var(--green);font-family:var(--f-mono);letter-spacing:.14em;font-size:11px}

    .ticker{
      background:var(--bg-2);border-top:1px solid var(--pink);border-bottom:1px solid var(--cyan);
      padding:8px 0;overflow:hidden;white-space:nowrap;
      font-family:var(--f-crt);font-size:22px;position:relative;z-index:10;
    }
    .mq{display:inline-flex;gap:44px;animation:scroll 60s linear infinite;padding-left:44px;width:max-content}
    .mq span{display:inline-flex;gap:12px;align-items:center;color:var(--cyan);text-shadow:0 0 10px rgba(62,224,255,.4)}
    .mq span:nth-child(2n){color:var(--pink);text-shadow:0 0 10px rgba(255,62,168,.4)}
    .mq span:nth-child(3n){color:var(--green);text-shadow:0 0 10px rgba(167,255,59,.4)}
    .mq span:nth-child(4n){color:var(--orange);text-shadow:0 0 10px rgba(255,145,52,.4)}
    .mq i{color:inherit;font-style:normal;font-family:var(--f-ser);font-weight:900;font-size:17px}
    @keyframes scroll{to{transform:translate3d(-50%,0,0)}}

    main{flex:1;padding:70px 28px 80px;max-width:1100px;margin:0 auto;width:100%;position:relative;z-index:2;text-align:center}

    .district{
      font-family:var(--f-ser);font-weight:900;
      font-size:clamp(22px,2.6vw,34px);
      color:var(--cyan);
      letter-spacing:.3em;
      margin-bottom:10px;
      text-shadow:0 0 16px rgba(62,224,255,.4),0 0 32px rgba(62,224,255,.2);
    }
    .district em{color:var(--pink);font-style:normal}

    h1.word{
      font-family:var(--f-chrome);
      font-size:clamp(78px,12vw,172px);
      line-height:.9;letter-spacing:.02em;color:var(--white);
      position:relative;
      text-shadow:
        -3px 0 var(--pink),3px 0 var(--cyan),
        0 0 32px rgba(255,62,168,.5),0 0 56px rgba(62,224,255,.3);
    }
    h1.word em{font-style:normal;color:var(--pink)}
    h1.word .dot{color:var(--green)}

    .tagline{
      display:inline-block;margin-top:22px;
      padding:10px 22px;font-family:var(--f-mich);font-size:clamp(13px,1.3vw,16px);letter-spacing:.2em;
      background:rgba(13,9,21,.7);
      border:1px solid var(--pink);
      color:var(--white);
      box-shadow:0 0 18px rgba(255,62,168,.4),inset 0 0 18px rgba(255,62,168,.1);
      text-transform:uppercase;
    }
    .tagline em{font-style:normal;color:var(--cyan);font-weight:400}

    .lede-wrap{max-width:640px;margin:36px auto 44px;font-family:var(--f-jp);font-size:15px;line-height:1.7;color:var(--white);opacity:.92}
    .lede-wrap b{color:var(--cyan);font-weight:700}
    .lede-wrap em{color:var(--pink);font-style:normal;font-weight:700}

    .neon-grid{
      display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:44px;
    }
    .neon-cell{
      background:rgba(13,9,21,.6);padding:16px 12px;
      border:1px solid var(--cyan);
      text-align:left;position:relative;
    }
    .neon-cell:nth-child(2){border-color:var(--pink)}
    .neon-cell:nth-child(3){border-color:var(--green)}
    .neon-cell:nth-child(4){border-color:var(--orange)}
    .neon-cell .k{font-family:var(--f-mich);font-size:9px;letter-spacing:.22em;color:var(--cyan);margin-bottom:8px;text-transform:uppercase}
    .neon-cell:nth-child(2) .k{color:var(--pink)}
    .neon-cell:nth-child(3) .k{color:var(--green)}
    .neon-cell:nth-child(4) .k{color:var(--orange)}
    .neon-cell .v{font-family:var(--f-chrome);font-size:22px;color:var(--white);line-height:1}
    .neon-cell .v em{color:var(--cyan);font-style:normal}

    .actions{display:flex;gap:12px;flex-wrap:wrap;justify-content:center;margin-bottom:42px}
    .btn{
      padding:13px 26px;
      font-family:var(--f-mich);font-size:12px;letter-spacing:.2em;text-transform:uppercase;
      border:1.5px solid var(--cyan);color:var(--cyan);
      background:rgba(13,9,21,.8);cursor:pointer;
      box-shadow:0 0 12px rgba(62,224,255,.3),inset 0 0 12px rgba(62,224,255,.05);
      transition:all .15s;
    }
    .btn:hover{background:var(--cyan);color:var(--bg);box-shadow:0 0 28px rgba(62,224,255,.7)}
    .btn.pri{border-color:var(--pink);color:var(--pink);box-shadow:0 0 12px rgba(255,62,168,.3)}
    .btn.pri:hover{background:var(--pink);color:var(--bg);box-shadow:0 0 28px rgba(255,62,168,.7)}

    .notify{
      max-width:540px;margin:0 auto;padding:24px 26px;
      background:rgba(13,9,21,.85);border:1px solid var(--pink);
      box-shadow:0 0 32px rgba(255,62,168,.2);
    }
    .notify .lbl{font-family:var(--f-mich);font-size:10px;letter-spacing:.28em;color:var(--cyan);margin-bottom:14px;text-transform:uppercase}
    .notify .lbl b{color:var(--pink)}
    .notify form{display:flex;gap:8px}
    .notify input{
      flex:1;padding:12px 16px;background:var(--bg);color:var(--white);
      border:1px solid var(--cyan);outline:none;
      font-family:var(--f-mono);font-size:13px;
    }
    .notify input:focus{border-color:var(--pink);box-shadow:0 0 14px rgba(255,62,168,.3)}
    .notify button{
      padding:0 22px;background:var(--pink);color:var(--bg);border:1px solid var(--pink);
      font-family:var(--f-mich);font-size:11px;letter-spacing:.18em;cursor:pointer;text-transform:uppercase;
    }
    .notify button:hover{background:var(--cyan);border-color:var(--cyan)}

    .privacy-consent{
      max-width:540px;margin:14px auto 0;font-family:var(--f-mich);font-size:10px;
      letter-spacing:.22em;color:var(--cyan);text-transform:uppercase;text-align:center;
    }
    .privacy-consent a{color:var(--pink);text-decoration:underline}

    footer{
      background:var(--bg-2);border-top:1px solid rgba(255,62,168,.3);
      padding:16px 28px;margin-top:18px;
      display:flex;justify-content:space-between;align-items:center;gap:14px;flex-wrap:wrap;
      font-family:var(--f-mich);font-size:10px;letter-spacing:.22em;color:var(--cyan);text-transform:uppercase;
      position:relative;z-index:10;
    }
    footer em{color:var(--pink);font-style:normal}
    footer a{color:var(--cyan)}
    footer a:hover{color:var(--pink)}

    @media (max-width:720px){
      .neon-grid{grid-template-columns:1fr 1fr}
      .notify form{flex-direction:column}
    }
  </style>

  <div class="top-bar">
    <span><span class="brand">BENTOO<em>/</em></span> 24時 · 新宿</span>
    <span class="clk" id="clk">00:00:00 JST</span>
  </div>

  <div class="ticker" aria-hidden="true">
    <div class="mq">
      {tickerSpansDoubled.map((s) => (
        <span><i>{s.kanji}</i> {s.text}</span>
      ))}
    </div>
  </div>

  <main>
    <div class="district">新宿 · <em>SHINJUKU</em> · 24:00</div>
    <h1 class="word">BENT<em>OO</em><span class="dot">.</span></h1>
    <div class="tagline" set:html={content.taglineHtml}></div>

    <div class="lede-wrap" set:html={content.ledeHtml}></div>

    <div class="neon-grid">
      <div class="neon-cell"><span class="k">RELEASE</span><span class="v"><em>0.1.0</em> ALPHA</span></div>
      <div class="neon-cell"><span class="k">ARCH</span><span class="v">X86-64-V3</span></div>
      <div class="neon-cell"><span class="k">{content.windowKey}</span><span class="v">{content.windowVal}</span></div>
      <div class="neon-cell"><span class="k">{content.kitchenKey}</span><span class="v">{content.kitchenVal}</span></div>
    </div>

    <div class="actions">
      <a class="btn pri" href="https://github.com/obentoo" target="_blank" rel="noopener">{content.btnSource}</a>
      <a class="btn" href="mailto:contact@obentoo.org">{content.btnContact}</a>
      <a class="btn" href="#notify">{content.btnNotify}</a>
    </div>

    <div class="notify" id="notify">
      <div class="lbl" set:html={content.pingLabelHtml}></div>
      <form
        data-bentoo-subscribe
        action={`https://buttondown.com/api/emails/embed-subscribe/${buttondownUser}`}
        method="post"
        data-success-msg={strings.successMsg}
        data-error-msg={strings.errorMsg}
      >
        <input type="hidden" name="embed" value="1" />
        <input type="email" name="email" required placeholder={strings.subscribePlaceholder} />
        <button type="submit">{strings.subscribeButton}</button>
      </form>
    </div>
    <p class="privacy-consent">
      {strings.privacyConsent} <a href={privacyHref}>{strings.privacyLinkLabel}</a>
    </p>
  </main>

  <footer>
    <span set:html={content.footerCopyHtml}></span>
    <span>
      <a href="https://github.com/obentoo" target="_blank" rel="noopener">github.com/obentoo</a>
      ·
      <a href="mailto:contact@obentoo.org">contact@obentoo.org</a>
    </span>
  </footer>

  <script is:inline>
    (function(){
      var c=document.getElementById('clk');
      if (!c) return;
      var p=function(n){return String(n).padStart(2,'0');};
      function t(){var d=new Date();c.textContent=p(d.getHours())+':'+p(d.getMinutes())+':'+p(d.getSeconds())+' JST';}
      t();setInterval(t,1000);
    })();
  </script>
</VariantLayout>
</content>
</invoke>