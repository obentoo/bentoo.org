---
import VariantLayout from '~/layouts/VariantLayout.astro';
import type { Lang } from '~/utils/getLang';
import { stringsFor } from '~/i18n';
import { v3 } from '~/i18n/variants/v3';
import { localizedPath } from '~/utils/siteUrl';

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const content = v3[lang];
const strings = stringsFor(lang);
const path = localizedPath('/v/v3/', lang);
const privacyHref = localizedPath('/privacy', lang);
const buttondownUser = import.meta.env.PUBLIC_BUTTONDOWN_USERNAME ?? 'bentoo';
const tickerSpansDoubled = [...content.tickerSpans, ...content.tickerSpans];
---
<VariantLayout
  lang={lang}
  path={path}
  title={content.title}
  description={content.description}
  variantSlug="v3"
>
  <Fragment slot="head-extra">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=VT323&family=Archivo+Black&family=Sora:wght@400;600;800&display=swap" rel="stylesheet" />
  </Fragment>
  <style slot="style">
    *,*::before,*::after{margin:0;padding:0;box-sizing:border-box}
    :root{
      --paper:#f4eacf; --paper-2:#ede0b9;
      --ink:#0a0a0a;
      --magenta:#ff1f8f; --magenta-2:#d10e72;
      --cyan:#00d4ff; --yellow:#ffd60a; --lime:#b6ff39;
      --purple:#8a4cff; --crimson:#ff2030;
      --f-pixel:'Press Start 2P',monospace;
      --f-crt:'VT323',monospace;
      --f-display:'Archivo Black',sans-serif;
      --f-body:'Sora',system-ui,sans-serif;
    }
    html,body{min-height:100vh}
    body{background:var(--paper);color:var(--ink);font-family:var(--f-body);font-size:15px;line-height:1.55;overflow-x:hidden;display:flex;flex-direction:column}
    body::before{
      content:'';position:fixed;inset:0;pointer-events:none;z-index:1;opacity:.5;
      background-image:
        radial-gradient(rgba(10,10,10,.06) 1px,transparent 1px),
        radial-gradient(rgba(10,10,10,.06) 1px,transparent 1px);
      background-size:20px 20px,20px 20px;background-position:0 0,10px 10px;
    }
    a{color:var(--ink);text-decoration:none}
    ::selection{background:var(--magenta);color:var(--paper)}

    /* Top bar */
    .topbar{
      background:var(--ink);color:var(--paper);
      padding:8px 26px;display:flex;justify-content:space-between;align-items:center;
      font-family:var(--f-pixel);font-size:10px;letter-spacing:.12em;
      border-bottom:4px solid var(--magenta);position:relative;z-index:10;
    }
    .topbar .brand{color:var(--yellow)}
    .topbar .brand em{color:var(--cyan);font-style:normal}
    .topbar .rt{color:var(--lime)}

    /* Ticker */
    .ticker{
      background:var(--magenta);color:var(--paper);
      padding:8px 0;overflow:hidden;white-space:nowrap;
      border-bottom:4px solid var(--ink);
      font-family:var(--f-crt);font-size:20px;letter-spacing:.12em;
      position:relative;z-index:10;
    }
    .mq{display:inline-flex;gap:42px;animation:scroll 60s linear infinite;padding-left:42px;width:max-content}
    .mq span{display:inline-flex;gap:10px;align-items:center}
    .mq i{color:var(--yellow);font-style:normal;font-family:var(--f-pixel);font-size:14px}
    @keyframes scroll{to{transform:translate3d(-50%,0,0)}}

    /* Main */
    main{flex:1;padding:56px 28px 80px;max-width:1080px;margin:0 auto;width:100%;position:relative;z-index:2}

    .hero-block{
      background:var(--paper);
      border:4px solid var(--ink);
      box-shadow:10px 10px 0 var(--magenta),10px 10px 0 4px var(--ink);
      padding:42px 44px;
      position:relative;
      display:grid;grid-template-columns:1fr auto;gap:32px;align-items:end;
    }
    .hero-block::before{
      content:'INSERT COIN';
      position:absolute;top:-18px;left:24px;
      background:var(--ink);color:var(--yellow);
      font-family:var(--f-pixel);font-size:10px;
      padding:6px 14px;letter-spacing:.18em;
      border:3px solid var(--ink);
    }

    .pill-status{
      display:inline-flex;align-items:center;gap:10px;
      background:var(--lime);color:var(--ink);
      font-family:var(--f-pixel);font-size:9px;letter-spacing:.14em;
      padding:6px 12px;border:2.5px solid var(--ink);margin-bottom:14px;
    }
    .pill-status b{background:var(--ink);color:var(--lime);padding:2px 6px}

    h1.word{
      font-family:var(--f-display);
      font-size:clamp(68px,11vw,148px);
      line-height:.86;letter-spacing:-.045em;
      color:var(--ink);text-transform:uppercase;
      position:relative;
      text-shadow:6px 6px 0 var(--magenta), 6px 6px 0 2px var(--ink);
    }
    h1.word em{font-style:normal;color:var(--cyan);text-shadow:6px 6px 0 var(--magenta),6px 6px 0 2px var(--ink)}
    h1.word .dot{color:var(--crimson)}

    .tagline{
      font-family:var(--f-display);
      font-size:clamp(18px,2vw,26px);
      letter-spacing:-.015em;color:var(--ink);
      margin:18px 0 16px;text-transform:uppercase;line-height:1.2;
    }
    .tagline em{font-style:normal;background:var(--yellow);padding:2px 10px;color:var(--ink)}

    p.lede{
      font-family:var(--f-body);
      font-size:16px;line-height:1.6;color:var(--ink);max-width:56ch;
      margin-bottom:24px;font-weight:500;
    }
    p.lede b{background:var(--cyan);padding:2px 6px}
    p.lede em{font-style:italic;color:var(--magenta-2);font-weight:700}

    .actions{display:flex;flex-wrap:wrap;gap:10px;margin-bottom:6px}
    .btn{
      display:inline-flex;align-items:center;gap:10px;
      background:var(--ink);color:var(--paper);
      padding:12px 22px;
      font-family:var(--f-pixel);font-size:11px;letter-spacing:.12em;
      border:3px solid var(--ink);
      box-shadow:4px 4px 0 var(--magenta);
      cursor:pointer;
    }
    .btn:hover{background:var(--magenta);box-shadow:4px 4px 0 var(--ink);transform:translate(-1px,-1px)}
    .btn.cyan{background:var(--cyan);color:var(--ink);box-shadow:4px 4px 0 var(--ink)}
    .btn.cyan:hover{background:var(--yellow)}

    .side-art{
      min-width:260px;
      background:var(--ink);
      border:4px solid var(--ink);
      padding:18px;
      position:relative;
    }
    .side-art img{width:100%;height:auto;filter:drop-shadow(0 0 0 1px var(--magenta))}
    .side-art::after{
      content:'PLAYER 1';position:absolute;bottom:-18px;left:50%;transform:translateX(-50%);
      background:var(--yellow);color:var(--ink);
      font-family:var(--f-pixel);font-size:9px;letter-spacing:.15em;
      padding:5px 12px;border:2.5px solid var(--ink);white-space:nowrap;
    }

    /* Newsletter */
    .notify{
      margin-top:40px;
      background:var(--ink);
      padding:24px 28px;
      border:4px solid var(--ink);
      box-shadow:8px 8px 0 var(--cyan),8px 8px 0 4px var(--ink);
      display:grid;grid-template-columns:auto 1fr;gap:22px;align-items:center;
    }
    .notify .label{
      font-family:var(--f-pixel);font-size:10px;letter-spacing:.14em;color:var(--yellow);
    }
    .notify .label b{color:var(--lime)}
    .notify form{display:flex;gap:0;width:100%}
    .notify input{
      flex:1;padding:14px 16px;background:var(--paper);color:var(--ink);
      font-family:var(--f-crt);font-size:17px;border:3px solid var(--paper);outline:none;
    }
    .notify input:focus{border-color:var(--yellow)}
    .notify button{
      padding:0 22px;background:var(--magenta);color:var(--paper);
      font-family:var(--f-pixel);font-size:11px;letter-spacing:.12em;
      border:3px solid var(--magenta);cursor:pointer;
    }
    .notify button:hover{background:var(--yellow);color:var(--ink);border-color:var(--yellow)}

    .privacy-consent{
      max-width:1080px;margin:18px auto 0;padding:0 28px;
      font-family:var(--f-pixel);font-size:9px;letter-spacing:.12em;color:var(--ink);text-align:center;
    }
    .privacy-consent a{color:var(--magenta-2);text-decoration:underline}

    /* Score bar footer */
    footer{
      background:var(--ink);color:var(--paper);
      padding:14px 26px;
      border-top:4px solid var(--magenta);
      font-family:var(--f-pixel);font-size:9px;letter-spacing:.12em;
      display:flex;justify-content:space-between;align-items:center;gap:18px;flex-wrap:wrap;
      position:relative;z-index:10;
    }
    footer a{color:var(--cyan)}
    footer a:hover{color:var(--yellow)}
    footer .copy em{color:var(--yellow);font-style:normal}
    footer .copy .dot{color:var(--crimson)}

    @media (max-width:820px){
      .hero-block{grid-template-columns:1fr;padding:28px 26px}
      .hero-block::before{top:-16px;left:16px}
      .side-art{display:none}
      .notify{grid-template-columns:1fr;text-align:center}
      .notify form{flex-direction:column;gap:8px}
      .notify button{padding:14px}
    }
  </style>

  <div class="topbar">
    <span><span class="brand">BENT<em>OO</em></span> · {content.arcadeTickerHeader}</span>
    <span class="rt" id="clk">00:00:00 · CREDIT 01</span>
  </div>

  <div class="ticker" aria-hidden="true">
    <div class="mq">
      {tickerSpansDoubled.map((s) => (
        <span><i>{s.kanji}</i> {s.text}</span>
      ))}
    </div>
  </div>

  <main>
    <section class="hero-block">
      <div>
        <span class="pill-status" set:html={content.pillStatusHtml}></span>
        <h1 class="word">BENT<em>OO</em><span class="dot">.</span></h1>
        <div class="tagline" set:html={content.taglineHtml}></div>
        <p class="lede" set:html={content.ledeHtml}></p>
        <div class="actions">
          <a class="btn cyan" href="https://github.com/obentoo" target="_blank" rel="noopener">► GITHUB</a>
          <a class="btn" href="mailto:contact@obentoo.org">{content.btnContact}</a>
          <a class="btn" href="#notify">{content.btnNotify}</a>
        </div>
      </div>
      <div class="side-art">
        <img src="/bentoo-logo.svg" alt={content.imgAlt} />
      </div>
    </section>

    <section class="notify" id="notify">
      <div class="label">HIGH SCORE<br /><b>{content.highScoreLabel}</b></div>
      <form
        data-bentoo-subscribe
        action={`https://buttondown.com/api/emails/embed-subscribe/${buttondownUser}`}
        method="post"
        data-success-msg={strings.successMsg}
        data-error-msg={strings.errorMsg}
      >
        <input type="hidden" name="embed" value="1" />
        <input type="email" name="email" required placeholder={strings.subscribePlaceholder} />
        <button type="submit">{strings.subscribeButton}</button>
      </form>
    </section>
    <p class="privacy-consent">
      {strings.privacyConsent} <a href={privacyHref}>{strings.privacyLinkLabel}</a>
    </p>
  </main>

  <footer>
    <span class="copy" set:html={content.footerCopyHtml}></span>
    <span>
      <a href="https://github.com/obentoo" target="_blank" rel="noopener">GITHUB.COM/OBENTOO</a>
      &nbsp;·&nbsp;
      <a href="mailto:contact@obentoo.org">CONTACT@OBENTOO.ORG</a>
    </span>
  </footer>

  <script is:inline>
    (function(){
      var clk = document.getElementById('clk');
      if (!clk) return;
      var pad = function(n){return String(n).padStart(2,'0');};
      function tick(){
        var d = new Date();
        clk.textContent = pad(d.getHours())+':'+pad(d.getMinutes())+':'+pad(d.getSeconds())+' · CREDIT 01';
      }
      tick(); setInterval(tick,1000);
    })();
  </script>
</VariantLayout>
</content>
</invoke>