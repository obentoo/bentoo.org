---
import VariantLayout from '~/layouts/VariantLayout.astro';
import type { Lang } from '~/utils/getLang';
import { stringsFor } from '~/i18n';
import { deathStrandingV3 } from '~/i18n/variants/death-stranding-v3';
import { localizedPath } from '~/utils/siteUrl';

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const content = deathStrandingV3[lang];
const strings = stringsFor(lang);
const path = localizedPath('/v/death-stranding-v3/', lang);
const privacyHref = localizedPath('/privacy', lang);
const buttondownUser = import.meta.env.PUBLIC_BUTTONDOWN_USERNAME ?? 'bentoo';
---
<VariantLayout
  lang={lang}
  path={path}
  title={content.title}
  description={content.description}
  variantSlug="death-stranding-v3"
>
  <Fragment slot="head-extra">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Rajdhani:wght@300;400;500;600;700&family=Chakra+Petch:wght@500;700&family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet" />
  </Fragment>
  <style slot="style">
    *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

    :root {
      --cave-1: #0e1014;
      --cave-2: #15181d;
      --cave-3: #1d2128;
      --amber:  #f7b463;
      --amber-2:#ff9030;
      --bb-glow:#ffcf88;
      --rain:   rgba(180,195,210,.15);
      --ghost:  rgba(255,255,255,.06);
      --ink:    #050608;
      --text:   #e8ecef;
      --text-dim:#9aa0a8;
      --blue:   #4a8bc4;
    }

    html, body { height: 100%; }
    body {
      font-family: 'Rajdhani', sans-serif;
      background: var(--cave-1);
      color: var(--text);
      overflow-x: hidden;
      -webkit-font-smoothing: antialiased;
      position: relative;
      min-height: 100vh;
    }

    /* Cave depth + vignette */
    body::before {
      content: '';
      position: fixed; inset: 0;
      background:
        radial-gradient(ellipse 55% 60% at 50% 45%, rgba(255,180,100,.08) 0%, transparent 50%),
        radial-gradient(ellipse 80% 60% at 50% 100%, rgba(20,30,40,.8) 0%, transparent 70%),
        radial-gradient(ellipse 90% 100% at 50% 50%, transparent 45%, rgba(0,0,0,.75) 100%),
        linear-gradient(180deg, #1a1e24 0%, #0c0e12 50%, #06070a 100%);
      z-index: 0;
    }

    /* Cave mouth silhouette */
    .cave-arc {
      position: fixed;
      top: -10%;
      left: 50%;
      transform: translateX(-50%);
      width: 120%;
      height: 80%;
      z-index: 1;
      pointer-events: none;
      opacity: .85;
    }
    .cave-arc svg { width: 100%; height: 100%; }

    /* Ghost hands */
    .hand {
      position: fixed;
      opacity: .22;
      filter: blur(1px);
      z-index: 1;
      pointer-events: none;
    }
    .hand svg { width: 100%; height: 100%; }
    .hand.h1 { top: 30%; left: 8%;  width: 90px;  transform: rotate(-12deg); }
    .hand.h2 { top: 45%; left: 14%; width: 70px;  transform: rotate(20deg); opacity: .16; }
    .hand.h3 { top: 38%; right: 10%;width: 80px;  transform: rotate(12deg); }
    .hand.h4 { top: 52%; right: 16%;width: 70px;  transform: rotate(-22deg); opacity: .14; }
    .hand.h5 { top: 62%; left: 28%; width: 60px;  transform: rotate(32deg); opacity: .12; }
    .hand.h6 { top: 70%; right: 28%;width: 60px;  transform: rotate(-30deg); opacity: .12; }

    /* Jellyfish floaters */
    .jelly {
      position: fixed;
      width: 50px; height: 70px;
      z-index: 1;
      pointer-events: none;
      opacity: .35;
      filter: blur(0.3px);
      animation: float 14s ease-in-out infinite;
    }
    .jelly svg { width: 100%; height: 100%; }
    .jelly.j1 { top: 35%; left: 4%;  animation-delay: 0s; }
    .jelly.j2 { top: 55%; right: 6%; animation-delay: -5s; }
    @keyframes float {
      0%, 100% { transform: translateY(0) translateX(0); }
      50%      { transform: translateY(-18px) translateX(6px); }
    }

    /* Rain */
    .rain {
      position: fixed; inset: 0;
      z-index: 2;
      pointer-events: none;
      background-image:
        linear-gradient(110deg, transparent 0 2px, var(--rain) 2px 3px, transparent 3px 7px),
        linear-gradient(110deg, transparent 0 5px, rgba(180,195,210,.1) 5px 6px, transparent 6px 14px),
        linear-gradient(110deg, transparent 0 1px, rgba(180,195,210,.08) 1px 2px, transparent 2px 11px);
      background-size: 8px 20px, 14px 32px, 11px 26px;
      animation: rain 1.2s linear infinite;
    }
    @keyframes rain {
      to {
        background-position:
          0 100px,
          0 140px,
          0 120px;
      }
    }

    /* ========== HEADER ========== */
    header {
      position: relative;
      z-index: 10;
      padding: 22px 38px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: var(--text-dim);
    }
    .tab-row { display: flex; gap: 20px; }
    .tab-row a { color: var(--text-dim); text-decoration: none; transition: color .2s; }
    .tab-row a:hover, .tab-row a.active { color: var(--amber); text-shadow: 0 0 8px rgba(247,180,99,.5); }

    /* ========== MAIN ========== */
    main {
      position: relative;
      z-index: 5;
      min-height: calc(100vh - 80px);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 26px;
      padding: 20px 24px 100px;
      text-align: center;
    }

    /* Wordmark with glitch/stroke + strikethrough */
    .wordmark {
      position: relative;
      font-family: 'Chakra Petch', sans-serif;
      font-weight: 700;
      font-size: clamp(3.5rem, 9.5vw, 8rem);
      letter-spacing: 0.08em;
      color: transparent;
      -webkit-text-stroke: 1.5px rgba(255,255,255,.75);
      text-stroke: 1.5px rgba(255,255,255,.75);
      line-height: 1;
      filter: drop-shadow(0 0 20px rgba(100,140,180,.3));
    }
    .wordmark::before, .wordmark::after {
      content: 'BENTOO';
      position: absolute;
      top: 0; left: 0; right: 0;
      -webkit-text-stroke: 1.5px;
      text-stroke: 1.5px;
    }
    .wordmark::before {
      -webkit-text-stroke-color: rgba(255,100,120,.6);
      text-stroke-color: rgba(255,100,120,.6);
      transform: translate(-3px, 1px);
      mix-blend-mode: screen;
    }
    .wordmark::after {
      -webkit-text-stroke-color: rgba(100,180,255,.6);
      text-stroke-color: rgba(100,180,255,.6);
      transform: translate(3px, -1px);
      mix-blend-mode: screen;
    }
    /* chord line across */
    .wordmark-line {
      position: relative;
      display: inline-block;
      animation: scanTremor 6s ease-in-out infinite;
    }
    .wordmark-line::after {
      content: '';
      position: absolute;
      left: -5%; right: -5%;
      top: 50%; height: 2px;
      background: linear-gradient(90deg, transparent 0%, rgba(255,255,255,.5) 12%, rgba(255,255,255,.8) 50%, rgba(255,255,255,.5) 88%, transparent 100%);
      transform: translateY(-50%);
    }
    .wordmark-line::before {
      content: '';
      position: absolute;
      left: -5%; right: -5%;
      top: 50%; height: 10px;
      transform: translateY(-50%);
      background:
        radial-gradient(circle 3px at 0 50%, #ff5050 0%, transparent 100%),
        radial-gradient(circle 3px at 100% 50%, #5080ff 0%, transparent 100%);
    }
    @keyframes scanTremor {
      0%, 100% { transform: translate(0,0); }
      12%      { transform: translate(-1px, 0); }
      18%      { transform: translate(1px, -1px); }
      70%      { transform: translate(0,0); }
    }

    /* BB Pod */
    .pod-wrap {
      position: relative;
      width: 180px; height: 220px;
      filter: drop-shadow(0 30px 40px rgba(255,160,80,.3));
      animation: podFloat 5s ease-in-out infinite;
    }
    @keyframes podFloat {
      0%, 100% { transform: translateY(0); }
      50%      { transform: translateY(-8px); }
    }
    .pod-wrap::before {
      content: '';
      position: absolute;
      inset: -60px;
      background: radial-gradient(circle at 50% 45%, rgba(255,180,100,.3) 0%, transparent 55%);
      z-index: -1;
    }
    .pod-wrap svg {
      width: 100%; height: 100%;
    }

    /* Tagline "dotted text" */
    .tagline {
      font-family: 'Chakra Petch', sans-serif;
      font-weight: 500;
      font-size: clamp(.95rem, 1.8vw, 1.5rem);
      letter-spacing: 0.32em;
      color: var(--text);
      text-transform: uppercase;
      position: relative;
      padding: 12px 0;
    }
    .tagline span {
      display: inline-block;
      position: relative;
    }
    .tagline span::after {
      content: '';
      position: absolute;
      left: 0; right: 0; top: 50%;
      height: 1.5px;
      background: rgba(255,255,255,.6);
      transform: translateY(-50%);
    }
    .tagline em { font-style: normal; color: var(--amber); text-shadow: 0 0 10px rgba(247,180,99,.4); }

    /* Cube buttons with circuit lines */
    .cubes {
      display: flex;
      gap: 40px;
      align-items: center;
      position: relative;
      margin-top: 10px;
    }
    .cubes::before {
      content: '';
      position: absolute;
      left: -20%; right: -20%;
      top: 50%;
      height: 1px;
      background: linear-gradient(90deg, transparent 0%, rgba(180,195,210,.25) 15%, rgba(180,195,210,.25) 85%, transparent 100%);
      z-index: -1;
    }
    .cube {
      position: relative;
      width: 130px; height: 130px;
      text-decoration: none;
      display: grid; place-items: center;
      transform-style: preserve-3d;
      perspective: 400px;
    }
    .cube-box {
      position: relative;
      width: 100%; height: 100%;
      background: linear-gradient(145deg, rgba(255,255,255,.08) 0%, rgba(255,255,255,.02) 100%);
      border: 1.5px solid rgba(255,255,255,.3);
      backdrop-filter: blur(10px);
      display: grid; place-items: center;
      color: var(--text);
      font-family: 'Chakra Petch', sans-serif;
      font-weight: 700;
      font-size: 1.05rem;
      letter-spacing: 0.25em;
      text-transform: uppercase;
      transition: all .3s;
      box-shadow:
        inset 0 1px 0 rgba(255,255,255,.2),
        inset 0 -1px 0 rgba(255,255,255,.1),
        0 20px 40px rgba(0,0,0,.4);
    }
    .cube-box::before {
      content: '';
      position: absolute;
      top: 4px; left: 4px;
      width: 16px; height: 16px;
      border-top: 1.5px solid var(--amber);
      border-left: 1.5px solid var(--amber);
    }
    .cube-box::after {
      content: '';
      position: absolute;
      bottom: 4px; right: 4px;
      width: 16px; height: 16px;
      border-bottom: 1.5px solid var(--amber);
      border-right: 1.5px solid var(--amber);
    }
    .cube:hover .cube-box {
      border-color: var(--amber);
      background: linear-gradient(145deg, rgba(247,180,99,.18) 0%, rgba(247,180,99,.05) 100%);
      transform: translateY(-4px);
      box-shadow: 0 30px 50px rgba(247,180,99,.25), inset 0 1px 0 rgba(255,255,255,.25);
    }
    /* circuit line connector dots */
    .cube::before, .cube::after {
      content: '';
      position: absolute;
      top: 50%;
      width: 10px; height: 10px;
      border-radius: 50%;
      background: rgba(180,195,210,.35);
      transform: translateY(-50%);
      z-index: 2;
    }
    .cube::before { left: -26px; }
    .cube::after  { right: -26px; }
    .cube:first-child::before, .cube:last-child::after { display: none; }

    .cube-label {
      position: absolute;
      bottom: -22px;
      font-family: 'JetBrains Mono', monospace;
      font-size: 9px;
      letter-spacing: 0.28em;
      color: var(--text-dim);
      text-transform: uppercase;
    }

    /* Notify */
    .notify-area {
      margin-top: 36px;
      width: 100%;
      max-width: 440px;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }
    .notify-area label {
      font-family: 'JetBrains Mono', monospace;
      font-size: 10.5px;
      letter-spacing: 0.3em;
      text-transform: uppercase;
      color: var(--text-dim);
      display: flex; justify-content: center; gap: 10px; align-items: center;
    }
    .notify-area label b { color: var(--amber); font-weight: 700; }
    .notify-row { display: flex; }
    .notify-row input {
      flex: 1;
      padding: 12px 16px;
      border: 1.5px solid rgba(255,255,255,.25);
      background: rgba(5,8,12,.6);
      color: var(--text);
      font-family: 'JetBrains Mono', monospace;
      font-size: 13px;
      outline: none;
      backdrop-filter: blur(8px);
    }
    .notify-row input:focus { border-color: var(--amber); }
    .notify-row button {
      padding: 12px 20px;
      border: 1.5px solid var(--amber);
      border-left: none;
      background: rgba(247,180,99,.1);
      color: var(--amber);
      font-family: 'Chakra Petch', sans-serif;
      font-weight: 700;
      font-size: 11px;
      letter-spacing: 0.25em;
      text-transform: uppercase;
      cursor: pointer;
      text-shadow: 0 0 8px rgba(247,180,99,.3);
    }

    .privacy-consent {
      margin-top: 10px;
      font-family: 'JetBrains Mono', monospace;
      font-size: 9.5px;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: var(--text-dim);
      text-align: center;
      max-width: 440px;
    }
    .privacy-consent a { color: var(--amber); font-weight: 700; }

    /* Footer */
    footer {
      position: fixed;
      bottom: 0; left: 0; right: 0;
      padding: 14px 28px;
      z-index: 10;
      display: flex; justify-content: space-between; flex-wrap: wrap; gap: 10px;
      font-family: 'JetBrains Mono', monospace;
      font-size: 10px;
      letter-spacing: 0.24em;
      text-transform: uppercase;
      color: var(--text-dim);
      background: linear-gradient(180deg, transparent 0%, rgba(5,8,12,.7) 50%);
    }
    footer b { color: var(--amber); font-weight: 700; }

    @media (max-width: 780px) {
      header { padding: 16px 20px; flex-wrap: wrap; gap: 10px; font-size: 10px; }
      .cubes { gap: 18px; }
      .cube { width: 92px; height: 92px; }
      .cube-box { font-size: .8rem; letter-spacing: 0.14em; }
      .hand { display: none; }
      main { padding: 20px 16px 120px; gap: 20px; }
    }
  </style>

  <div class="cave-arc" aria-hidden="true">
    <svg viewBox="0 0 1400 800" preserveAspectRatio="none">
      <defs>
        <linearGradient id="ca" x1="0" x2="0" y1="0" y2="1">
          <stop offset="0%" stop-color="#0a0c10"/>
          <stop offset="100%" stop-color="#1e242c"/>
        </linearGradient>
      </defs>
      <path fill="url(#ca)" d="M0,0 L0,260 Q40,280 90,230 T200,250 Q260,300 320,240 T440,220 Q500,180 560,220 T700,200 Q760,240 820,210 T960,230 Q1040,260 1120,220 T1240,240 Q1320,280 1400,250 L1400,0 Z"/>
    </svg>
  </div>

  <div class="hand h1"><svg viewBox="0 0 100 120" fill="#10141a"><path d="M30 120 L30 60 Q28 45 36 45 Q44 45 44 60 L44 40 Q44 25 52 25 Q60 25 60 40 L60 60 L60 30 Q60 18 68 18 Q76 18 76 30 L76 65 Q76 48 84 48 Q92 48 92 60 L92 90 Q92 120 60 120 Z"/></svg></div>
  <div class="hand h2"><svg viewBox="0 0 100 120" fill="#10141a"><path d="M30 120 L30 60 Q28 45 36 45 Q44 45 44 60 L44 40 Q44 25 52 25 Q60 25 60 40 L60 60 L60 30 Q60 18 68 18 Q76 18 76 30 L76 65 Q76 48 84 48 Q92 48 92 60 L92 90 Q92 120 60 120 Z"/></svg></div>
  <div class="hand h3"><svg viewBox="0 0 100 120" fill="#10141a"><path d="M30 120 L30 60 Q28 45 36 45 Q44 45 44 60 L44 40 Q44 25 52 25 Q60 25 60 40 L60 60 L60 30 Q60 18 68 18 Q76 18 76 30 L76 65 Q76 48 84 48 Q92 48 92 60 L92 90 Q92 120 60 120 Z"/></svg></div>
  <div class="hand h4"><svg viewBox="0 0 100 120" fill="#10141a"><path d="M30 120 L30 60 Q28 45 36 45 Q44 45 44 60 L44 40 Q44 25 52 25 Q60 25 60 40 L60 60 L60 30 Q60 18 68 18 Q76 18 76 30 L76 65 Q76 48 84 48 Q92 48 92 60 L92 90 Q92 120 60 120 Z"/></svg></div>
  <div class="hand h5"><svg viewBox="0 0 100 120" fill="#10141a"><path d="M30 120 L30 60 Q28 45 36 45 Q44 45 44 60 L44 40 Q44 25 52 25 Q60 25 60 40 L60 60 L60 30 Q60 18 68 18 Q76 18 76 30 L76 65 Q76 48 84 48 Q92 48 92 60 L92 90 Q92 120 60 120 Z"/></svg></div>
  <div class="hand h6"><svg viewBox="0 0 100 120" fill="#10141a"><path d="M30 120 L30 60 Q28 45 36 45 Q44 45 44 60 L44 40 Q44 25 52 25 Q60 25 60 40 L60 60 L60 30 Q60 18 68 18 Q76 18 76 30 L76 65 Q76 48 84 48 Q92 48 92 60 L92 90 Q92 120 60 120 Z"/></svg></div>

  <div class="jelly j1" aria-hidden="true">
    <svg viewBox="0 0 50 70">
      <ellipse cx="25" cy="20" rx="18" ry="14" fill="none" stroke="rgba(200,220,240,.6)" stroke-width="1"/>
      <path d="M14 28 Q13 48 11 68 M20 30 Q18 52 17 68 M25 30 Q25 52 25 68 M30 30 Q32 52 33 68 M36 28 Q37 48 39 68" fill="none" stroke="rgba(200,220,240,.4)" stroke-width="1"/>
    </svg>
  </div>
  <div class="jelly j2" aria-hidden="true">
    <svg viewBox="0 0 50 70">
      <ellipse cx="25" cy="20" rx="18" ry="14" fill="none" stroke="rgba(200,220,240,.6)" stroke-width="1"/>
      <path d="M14 28 Q13 48 11 68 M20 30 Q18 52 17 68 M25 30 Q25 52 25 68 M30 30 Q32 52 33 68 M36 28 Q37 48 39 68" fill="none" stroke="rgba(200,220,240,.4)" stroke-width="1"/>
    </svg>
  </div>

  <div class="rain" aria-hidden="true"></div>

  <header>
    <div style="font-family:'Chakra Petch',sans-serif;font-weight:700;font-size:1rem;letter-spacing:.2em;color:var(--text)">BT · STAGE5</div>
    <div class="tab-row">
      <a href="#" class="active">{content.navLanding}</a>
      <a href="https://github.com/obentoo" target="_blank" rel="noopener">{content.navSource}</a>
      <a href="mailto:contact@obentoo.org">{content.navContact}</a>
    </div>
    <div style="color:var(--amber);text-shadow:0 0 8px rgba(247,180,99,.4)">{content.signalLine}</div>
  </header>

  <main>
    <div class="wordmark"><span class="wordmark-line">BENTOO</span></div>

    <div class="pod-wrap" aria-hidden="true">
      <svg viewBox="0 0 180 220">
        <defs>
          <radialGradient id="bbglow" cx="50%" cy="40%" r="50%">
            <stop offset="0%" stop-color="#fff4d6"/>
            <stop offset="40%" stop-color="#ffcf88"/>
            <stop offset="80%" stop-color="#d68836"/>
            <stop offset="100%" stop-color="#5c3816"/>
          </radialGradient>
          <linearGradient id="pbase" x1="0" x2="0" y1="0" y2="1">
            <stop offset="0%" stop-color="#b78a4c"/>
            <stop offset="100%" stop-color="#5d4422"/>
          </linearGradient>
        </defs>
        <!-- glass dome -->
        <path d="M40 30 Q40 10 90 10 Q140 10 140 30 L140 155 L40 155 Z" fill="url(#bbglow)" opacity=".9"/>
        <path d="M40 30 Q40 10 90 10 Q140 10 140 30 L140 155 L40 155 Z" fill="none" stroke="rgba(255,220,170,.7)" stroke-width="1.5"/>
        <!-- BB curled -->
        <ellipse cx="90" cy="90" rx="28" ry="22" fill="#f4d4a3"/>
        <circle cx="90" cy="75" r="18" fill="#f4d4a3"/>
        <path d="M82 75 Q84 78 86 75 M94 75 Q96 78 98 75" stroke="#76542c" stroke-width="1.2" fill="none"/>
        <path d="M86 85 Q90 88 94 85" stroke="#76542c" stroke-width=".8" fill="none"/>
        <!-- umbilical -->
        <path d="M90 105 Q95 115 92 130" stroke="#c49260" stroke-width="2" fill="none"/>
        <!-- base -->
        <rect x="34" y="150" width="112" height="40" fill="url(#pbase)" rx="3"/>
        <circle cx="60" cy="170" r="4" fill="#3a2812"/>
        <circle cx="120" cy="170" r="4" fill="#3a2812"/>
        <rect x="78" y="158" width="24" height="4" fill="#3a2812"/>
        <!-- fluid bubbles -->
        <circle cx="56" cy="48" r="3" fill="rgba(255,255,255,.4)"/>
        <circle cx="120" cy="62" r="2" fill="rgba(255,255,255,.35)"/>
        <circle cx="70" cy="128" r="2.5" fill="rgba(255,255,255,.3)"/>
        <circle cx="118" cy="120" r="2" fill="rgba(255,255,255,.35)"/>
        <!-- exhaust -->
        <path d="M60 190 L50 210" stroke="rgba(255,200,150,.4)" stroke-width="6"/>
        <path d="M90 190 L90 215" stroke="rgba(255,200,150,.5)" stroke-width="8"/>
        <path d="M120 190 L130 210" stroke="rgba(255,200,150,.4)" stroke-width="6"/>
      </svg>
    </div>

    <div class="tagline">
      <span set:html={content.taglineHtml}></span>
    </div>

    <div class="cubes">
      <a class="cube" href="https://github.com/obentoo" target="_blank" rel="noopener">
        <div class="cube-box">GITHUB</div>
        <span class="cube-label">{content.cubeLabelSource}</span>
      </a>
      <a class="cube" href="mailto:contact@obentoo.org">
        <div class="cube-box">{content.cubeBoxContact}</div>
        <span class="cube-label">BRIDGE</span>
      </a>
      <a class="cube" href="#notify">
        <div class="cube-box">{content.cubeBoxNotify}</div>
        <span class="cube-label">ME</span>
      </a>
    </div>

    <form
      class="notify-area"
      id="notify"
      data-bentoo-subscribe
      action={`https://buttondown.com/api/emails/embed-subscribe/${buttondownUser}`}
      method="post"
      data-success-msg={strings.successMsg}
      data-error-msg={strings.errorMsg}
    >
      <label set:html={content.chiralLabelHtml}></label>
      <input type="hidden" name="embed" value="1" />
      <div class="notify-row">
        <input type="email" name="email" required placeholder={strings.subscribePlaceholder} />
        <button type="submit">{strings.subscribeButton} →</button>
      </div>
    </form>
    <p class="privacy-consent">
