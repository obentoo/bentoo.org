{
  "name": "bentoo-website",
  "version": "0.1.0",
  "description": "obentoo.org — coming-soon landing site (Astro 7 + Cloudflare Workers Static Assets)",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=22.18.0",
    "pnpm": ">=12.7.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "astro check && tsc --noEmit",
    "test:unit": "vitest run",
    "test:visual": "playwright test --project=visual",
    "test:integration": "playwright test --project=integration",
    "check:js": "node scripts/check-js-budget.mjs",
    "check:og": "node scripts/check-og-images.mjs",
    "check:forms": "node scripts/verify-forms.mjs",
    "check:variants-sync": "node scripts/check-variants-sync.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/obentoo/bentoo.org.git"
  },
  "bugs": {
    "url": "https://github.com/obentoo/bentoo.org/issues"
  },
  "homepage": "https://obentoo.org",
  "license": "UNLICENSED",
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "astro": "^7.3.5",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "js-yaml": "5.4.2",
    "jsdom": "30.1.1",
    "vitest": "5.0.2",
    "wrangler": "4.144.0"
  }
}
