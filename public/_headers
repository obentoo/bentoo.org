/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: interest-cohort=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' static.cloudflareinsights.com; connect-src 'self' cloudflareinsights.com; img-src 'self' data:; font-src 'self' fonts.gstatic.com; style-src 'self' 'unsafe-inline' fonts.googleapis.com; form-action 'self' buttondown.com; frame-src buttondown.com
/notices.json
  ! Content-Type
  Content-Type: application/feed+json; charset=utf-8
/notices.atom
  ! Content-Type
  Content-Type: application/atom+xml; charset=utf-8
/.well-known/security.txt
  ! Content-Type
  Content-Type: text/plain; charset=utf-8
