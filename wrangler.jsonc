{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bentoo",
  "compatibility_date": "2026-05-07",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "obentoo.org", "custom_domain": true },
    { "pattern": "www.obentoo.org", "custom_domain": true }
  ]
}
